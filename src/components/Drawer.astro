---
import { NAV_MENU, CONTACT } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
---

<div class="drawer-side z-[60]">
  <label for="my-drawer-2" aria-label="Menü schliessen" class="drawer-overlay"></label>
  <div class="flex min-h-full w-80 flex-col bg-white p-6 text-[var(--hrr-text)]">
    <Logo />
    <ul class="mt-8 grid border-t border-[var(--hrr-line)]">
      {NAV_MENU.map((item) => (
        <li class="border-b border-[var(--hrr-line)]">
          <HeaderLink href={item.url} class="nav-link block py-4 font-semibold text-[var(--hrr-ink)]">
            {item.title}
          </HeaderLink>
        </li>
      ))}
    </ul>
    <div class="mt-auto grid gap-3 pt-8">
      <a href={CONTACT.phoneHref} class="btn-line w-full"><Icon name="lucide:phone" size={18} /> {CONTACT.phone}</a>
      <a href="/contact" class="btn-main w-full">Offerte anfragen</a>
    </div>
  </div>
</div>
