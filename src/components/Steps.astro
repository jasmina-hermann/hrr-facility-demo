---
// "So läuft es ab" – drei einfache Schritte
const steps = [
  { title: "Anfrage & Offerte", text: "Sie melden sich bei uns. Wir besprechen Ihr Anliegen und erstellen eine kostenlose Offerte." },
  { title: "Termin festlegen", text: "Gemeinsam legen wir den Zeitplan fest – einmalig oder regelmässig." },
  { title: "Erledigt!", text: "Wir führen die Arbeiten pünktlich und sauber aus. Sie haben einen festen Ansprechpartner." },
];
---

<section class="section bg-white">
  <div class="site-shell">
    <span class="eyebrow">So läuft es ab</span>
    <h2 class="max-w-xl">In drei Schritten zur Lösung</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="border-t-2 border-[var(--hrr-orange)] pt-5">
          <span class="num text-[var(--hrr-orange)]">{i + 1}</span>
          <h3 class="mt-2">{s.title}</h3>
          <p class="text-[var(--hrr-muted)]">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
