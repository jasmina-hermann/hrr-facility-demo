---
// Kopfbereich für Unterseiten: Text links, Foto rechts
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: { src: string; alt: string };
}
const { eyebrow, title, text, image } = Astro.props;
---

<section class="bg-[var(--hrr-sand)]">
  <div class="site-shell grid items-center gap-10 py-12 md:py-16 lg:grid-cols-2 lg:gap-16">
    <div>
      <nav class="mb-6 text-sm text-[var(--hrr-muted)]" aria-label="Brotkrumen">
        <a href="/" class="hover:text-[var(--hrr-orange)]">Startseite</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--hrr-ink)]">{eyebrow}</span>
      </nav>
      <h1>{title}</h1>
      <p class="lead max-w-xl">{text}</p>
      <slot />
    </div>
    <div class="photo aspect-[4/3]">
      <img src={image.src} alt={image.alt} loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>
