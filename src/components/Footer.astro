---
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import { CONTACT, SERVICES } from "../consts";
const year = new Date().getFullYear();
---

<footer class="bg-[var(--hrr-sand)] text-[var(--hrr-text)]">
  <div class="site-shell py-14 md:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-5 max-w-xs text-[var(--hrr-muted)]">
          Reinigung, Hauswartung, Renovierungsarbeiten und Gartenunterhalt – mit über 20 Jahren Erfahrung.
        </p>
        <a href={CONTACT.instagram} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 font-semibold text-[var(--hrr-ink)] hover:text-[var(--hrr-orange)]">
          <Icon name="simple-icons:instagram" size={18} /> hrr_mavraj
        </a>
      </div>

      <div>
        <h4 class="!text-base">Kontakt</h4>
        <ul class="grid gap-2 text-[var(--hrr-muted)]">
          <li><a href={CONTACT.phoneHref} class="inline-flex items-center gap-2 hover:text-[var(--hrr-orange)]"><Icon name="lucide:phone" size={16} /> {CONTACT.phone}</a></li>
          <li><a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-[var(--hrr-orange)]"><Icon name="lucide:message-circle" size={16} /> {CONTACT.mobile}</a></li>
          <li><a href={CONTACT.emailHref} class="inline-flex items-center gap-2 hover:text-[var(--hrr-orange)]"><Icon name="lucide:mail" size={16} /> {CONTACT.email}</a></li>
          <li class="inline-flex items-start gap-2"><Icon name="lucide:map-pin" size={16} class="mt-1 shrink-0" /> <span>{CONTACT.street}<br />{CONTACT.city}</span></li>
        </ul>
      </div>

      <div>
        <h4 class="!text-base">Öffnungszeiten</h4>
        <ul class="grid gap-2 text-[var(--hrr-muted)]">
          {CONTACT.hours.map((h) => (
            <li><span class="block text-[var(--hrr-ink)]">{h.days}</span>{h.time}</li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="!text-base">Seiten</h4>
        <ul class="grid gap-2 text-[var(--hrr-muted)]">
          {SERVICES.map((s) => (
            <li><a href={s.url} class="hover:text-[var(--hrr-orange)]">{s.title}</a></li>
          ))}
          <li><a href="/about" class="hover:text-[var(--hrr-orange)]">Über uns</a></li>
          <li><a href="/contact" class="hover:text-[var(--hrr-orange)]">Kontakt</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-[var(--hrr-line)] pt-6 text-sm text-[var(--hrr-muted)] sm:flex-row sm:justify-between">
      <span>© {year} H-R-R Facility GmbH</span>
      <span class="flex gap-5">
        <a href="/impressum" class="hover:text-[var(--hrr-orange)]">Impressum</a>
        <a href="/policy" class="hover:text-[var(--hrr-orange)]">Datenschutz</a>
      </span>
    </div>
  </div>
</footer>
