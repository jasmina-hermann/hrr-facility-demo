---
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import { CONTACT } from "../consts";
const year = new Date().getFullYear();
---

<footer class="bg-[var(--hrr-sand)] text-[var(--hrr-text)]">
  <div class="site-shell py-14 md:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-5 max-w-xs text-[var(--hrr-muted)]">
          Reinigung und Hauswartung für Liegenschaften, Unternehmen und Privathaushalte.
        </p>
      </div>

      <div>
        <h4 class="!text-base">Kontakt</h4>
        <ul class="grid gap-2 text-[var(--hrr-muted)]">
          <li><a href={CONTACT.phoneHref} class="inline-flex items-center gap-2 hover:text-[var(--hrr-orange)]"><Icon name="lucide:phone" size={16} /> {CONTACT.phone}</a></li>
          <li><a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-[var(--hrr-orange)]"><Icon name="lucide:message-circle" size={16} /> {CONTACT.mobile}</a></li>
          <li><a href={CONTACT.emailHref} class="inline-flex items-center gap-2 hover:text-[var(--hrr-orange)]"><Icon name="lucide:mail" size={16} /> {CONTACT.email}</a></li>
          <li class="inline-flex items-start gap-2"><Icon name="lucide:map-pin" size={16} class="mt-1 shrink-0" /> <span>{CONTACT.street}<br />{CONTACT.city}</span></li>
        </ul>
      </div>

      <div>
        <h4 class="!text-base">Dienstleistungen</h4>
        <ul class="grid gap-2 text-[var(--hrr-muted)]">
          <li><a href="/reinigung" class="hover:text-[var(--hrr-orange)]">Reinigung</a></li>
          <li><a href="/reinigung#geschaeftlich" class="hover:text-[var(--hrr-orange)]">Büro- &amp; Gewerbereinigung</a></li>
          <li><a href="/hauswartung" class="hover:text-[var(--hrr-orange)]">Hauswartung</a></li>
          <li><a href="/hauswartung#umgebung" class="hover:text-[var(--hrr-orange)]">Umgebungspflege</a></li>
        </ul>
      </div>

      <div>
        <h4 class="!text-base">H-R-R Facility</h4>
        <ul class="grid gap-2 text-[var(--hrr-muted)]">
          <li><a href="/about" class="hover:text-[var(--hrr-orange)]">Über uns</a></li>
          <li><a href="/contact" class="hover:text-[var(--hrr-orange)]">Kontakt</a></li>
          <li><a href="/impressum" class="hover:text-[var(--hrr-orange)]">Impressum</a></li>
          <li><a href="/policy" class="hover:text-[var(--hrr-orange)]">Datenschutz</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-[var(--hrr-line)] pt-6 text-sm text-[var(--hrr-muted)] sm:flex-row sm:justify-between">
      <span>© {year} H-R-R Facility GmbH</span>
      <span>{CONTACT.region}</span>
    </div>
  </div>
</footer>
