---
const today = new Date();
import Logo from "./Logo.astro";
---

<footer class="border-t border-[#ebe4dc] bg-[#fbfaf8] text-[#2b2b2b]">
  <div class="container py-14 md:py-18">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
      <div>
        <Logo />
        <p class="mt-5 max-w-sm leading-relaxed text-[#68635e]">Reinigung und Hauswartung mit persönlicher Betreuung, hohen Qualitätsstandards und zuverlässigem 24/7-Service.</p>
      </div>
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-[#ef7f1a]">Navigation</p>
        <div class="grid gap-3">
          <a href="/reinigung" class="hover:text-[#ef7f1a]">Reinigung</a>
          <a href="/hauswartung" class="hover:text-[#ef7f1a]">Hauswartung</a>
          <a href="/about" class="hover:text-[#ef7f1a]">Über uns</a>
          <a href="/contact" class="hover:text-[#ef7f1a]">Kontakt</a>
        </div>
      </div>
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-[#ef7f1a]">Direkt erreichbar</p>
        <div class="grid gap-3 text-[#5f5a55]">
          <a href="tel:+41716887851" class="hover:text-[#ef7f1a]">071 688 78 51</a>
          <a href="https://wa.me/41774805454" target="_blank" rel="noopener" class="hover:text-[#ef7f1a]">WhatsApp: 077 480 54 54</a>
          <a href="mailto:Info@h-r-r.ch" class="hover:text-[#ef7f1a]">Info@h-r-r.ch</a>
          <p>Hauptstrasse 137b, 8274 Tägerwilen</p>
        </div>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-3 border-t border-[#e7dfd7] pt-7 text-sm text-[#77716b] sm:flex-row sm:items-center sm:justify-between">
      <span>© {today.getFullYear()} H-R-R Facility GmbH</span>
      <span>Kreuzlingen · Winterthur · Region</span>
    </div>
  </div>
</footer>
