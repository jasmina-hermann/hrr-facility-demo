---
// Seite für eine Kundengruppe (Privat oder Geschäftlich).
// Aufbau: Kopfbereich, vier Leistungsgruppen mit Listen, Info-Band,
// Partner-Text mit Kontaktkarte, Stärken im Überblick.
import { Icon } from "astro-icon/components";
import PageHero from "./PageHero.astro";
import { CONTACT } from "../consts";

interface Group {
  icon: string;
  title: string;
  items: string[];
  href: string;
}

interface Props {
  kind: "privat" | "geschaeftlich";
  kicker: string; // kleine Zeile im dunklen Kopfbereich
  title: string; // Seitenname im dunklen Kopfbereich
  tagline: string; // kurze Zeile unter dem Seitennamen
  icon: string;
  groupsTitle: string;
  groups: Group[];
  partnerTitle: string;
  partnerText: string[];
  photo: { src: string; alt: string; fallback?: string; pos?: string };
}

const { kind, kicker, title, tagline, icon, groupsTitle, groups, partnerTitle, partnerText, photo } = Astro.props;

const offer = `/contact?fuer=${kind}`;

const strengths = [
  {
    icon: "lucide:user-round-check",
    title: "Eine feste Ansprechperson",
    text: "Vom ersten Gespräch bis zum laufenden Auftrag haben Sie eine Person, die Ihr Objekt kennt.",
  },
  {
    icon: "lucide:messages-square",
    title: "Persönliche Beratung",
    text: "Wir schauen uns alles vor Ort an und planen mit Ihnen, was wirklich nötig ist.",
  },
  {
    icon: "lucide:timer",
    title: "Schnelle Reaktion",
    text: "Fragen und Sonderwünsche beantworten wir in der Regel am gleichen oder nächsten Arbeitstag.",
  },
];
---

<!-- 1. Kopfbereich (gleich wie auf allen Unterseiten) -->
<PageHero kicker={kicker} title={title} text={tagline} icon={icon} />

<!-- 2. Vier Leistungsgruppen -->
<section class="section bg-white">
  <div class="site-shell">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Unsere Leistungen</span>
      <h2>{groupsTitle}</h2>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2" data-stagger>
      {groups.map((g, i) => (
        <div class="flex">
          <article class="aud-group">
            <header class="aud-group__head">
              <span class="aud-group__icon"><Icon name={g.icon} size={26} /></span>
              <h3 class="aud-group__title">{g.title}</h3>
              <span class="aud-group__num">{String(i + 1).padStart(2, "0")}</span>
            </header>
            <ul class="aud-group__list">
              {g.items.map((item) => (
                <li><Icon name="lucide:check" size={18} class="shrink-0 text-[var(--hrr-orange)]" /> {item}</li>
              ))}
            </ul>
            <a href={g.href} class="aud-group__more group">
              Mehr erfahren
              <Icon name="lucide:arrow-right" size={17} class="transition-transform duration-300 group-hover:translate-x-1" />
            </a>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 3. Info-Band -->
<section class="bg-white pb-20 md:pb-28">
  <div class="site-shell">
    <div class="aud-band">
      <div class="aud-band__shine" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="aud-band__title">Brauchen Sie weitere Infos?</h2>
        <p class="aud-band__text">Rufen Sie an oder schreiben Sie uns kurz. Wir beraten Sie persönlich und kostenlos.</p>
      </div>
      <div class="relative flex flex-col gap-3 sm:flex-row">
        <a href={offer} class="aud-band__btn aud-band__btn--white">Kontakt aufnehmen <Icon name="lucide:arrow-right" size={18} /></a>
        <a href={CONTACT.phoneHref} class="aud-band__btn aud-band__btn--ghost"><Icon name="lucide:phone" size={18} /> {CONTACT.phone}</a>
      </div>
    </div>
  </div>
</section>

<!-- 4. Partner-Text und Kontaktkarte mit Foto -->
<section class="section section-sand">
  <div class="site-shell grid items-center gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
    <div>
      <span class="eyebrow">H-R-R Facility GmbH</span>
      <h2>{partnerTitle}</h2>
      {partnerText.map((p, i) => (
        <p class:list={[i === 0 ? "lead" : "mt-4 text-[var(--hrr-muted)]"]}>{p}</p>
      ))}
    </div>

    <aside class="aud-contact">
      <div class="aud-contact__photo">
        <img
          src={photo.src}
          alt={photo.alt}
          loading="lazy"
          style={photo.pos ? `object-position: ${photo.pos}` : undefined}
          onerror={photo.fallback ? `this.onerror=null;this.src='${photo.fallback}'` : undefined}
        />
      </div>
      <div class="aud-contact__body">
        <h3 class="aud-contact__title">Jetzt kostenlose Offerte anfordern</h3>
        <p class="text-[15px] text-[var(--hrr-muted)]">Unverbindlich. Wir melden uns persönlich.</p>
        <ul class="mt-5 grid gap-2.5">
          <li><a href={CONTACT.phoneHref} class="aud-contact__link"><Icon name="lucide:phone" size={18} /> {CONTACT.phone}</a></li>
          <li><a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="aud-contact__link"><Icon name="lucide:message-circle" size={18} /> WhatsApp {CONTACT.mobile}</a></li>
          <li><a href={CONTACT.emailHref} class="aud-contact__link"><Icon name="lucide:mail" size={18} /> {CONTACT.email}</a></li>
        </ul>
        <a href={offer} class="btn-main mt-6 w-full">Zum Offertenformular <Icon name="lucide:arrow-right" size={18} /></a>
      </div>
    </aside>
  </div>
</section>

<!-- 5. Stärken im Überblick -->
<section class="section bg-white">
  <div class="site-shell">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="eyebrow">Warum H-R-R</span>
        <h2 class="!mb-0">Unsere Stärken im Überblick</h2>
      </div>
      <a href="/about" class="aud-group__more group !mt-0 !pt-0">
        Mehr über uns
        <Icon name="lucide:arrow-right" size={17} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3" data-stagger>
      {strengths.map((s) => (
        <div class="aud-strength">
          <span class="aud-strength__icon"><Icon name={s.icon} size={24} /></span>
          <h3 class="aud-strength__title">{s.title}</h3>
          <p class="text-[15px] text-[var(--hrr-muted)]">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---------- Leistungsgruppen ---------- */
  .aud-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 2rem 1.75rem 1.75rem;
    border-radius: 20px;
    background: #fff;
    border: 1px solid var(--hrr-line);
    box-shadow: 0 10px 30px rgba(20, 22, 25, .05);
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s ease, border-color .5s ease;
  }
  @media (min-width: 768px) {
    .aud-group { padding: 2.4rem 2.4rem 2.1rem; }
  }
  .aud-group:hover {
    transform: translateY(-6px);
    border-color: rgba(232, 118, 26, .45);
    box-shadow: 0 26px 50px rgba(20, 22, 25, .1);
  }
  .aud-group__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.3rem;
    border-bottom: 1px solid var(--hrr-line);
  }
  .aud-group__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, #F8A24C 0%, #E8761A 55%, #C9620F 100%);
    color: #fff;
    box-shadow: 0 10px 22px rgba(232, 118, 26, .3);
  }
  .aud-group__title {
    margin: 0;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 800;
    line-height: 1.2;
    color: var(--hrr-ink);
  }
  .aud-group__num {
    margin-left: auto;
    font-family: var(--font-head);
    font-size: .85rem;
    font-weight: 700;
    color: var(--hrr-muted);
  }
  .aud-group__list {
    display: grid;
    gap: .7rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .aud-group__list li {
    display: flex;
    align-items: flex-start;
    gap: .7rem;
    color: var(--hrr-text);
  }
  .aud-group__list li :global(svg) { margin-top: .2rem; }
  .aud-group__more {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: auto;
    padding-top: 1.6rem;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--hrr-orange);
  }
  .aud-group__more:hover { color: var(--hrr-orange-dark); }

  /* ---------- Info-Band ---------- */
  .aud-band {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding: 2.2rem 1.75rem;
    border-radius: 22px;
    color: #fff;
    background: linear-gradient(135deg, #F8A24C 0%, #E8761A 45%, #B8520C 100%);
    box-shadow: 0 30px 60px rgba(232, 118, 26, .25);
  }
  @media (min-width: 1024px) {
    .aud-band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2.8rem 3.2rem;
    }
  }
  .aud-band__shine {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -120px;
    top: -200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, .35) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }
  .aud-band__title {
    margin: 0;
    color: #fff;
    font-size: clamp(26px, 2.8vw, 34px);
    font-weight: 800;
    line-height: 1.15;
  }
  .aud-band__text {
    margin: .5rem 0 0;
    color: rgba(255, 255, 255, .88);
  }
  .aud-band__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    padding: .95rem 1.6rem;
    border-radius: 999px;
    font-family: var(--font-head);
    font-weight: 700;
    white-space: nowrap;
    transition: background-color .3s ease, transform .3s ease, border-color .3s ease;
  }
  .aud-band__btn:hover { transform: translateY(-2px); }
  .aud-band__btn--white { background: #fff; color: var(--hrr-orange-dark); }
  .aud-band__btn--white:hover { background: #FFF4EA; }
  .aud-band__btn--ghost { border: 1px solid rgba(255, 255, 255, .6); color: #fff; }
  .aud-band__btn--ghost:hover { border-color: #fff; background: rgba(255, 255, 255, .1); }

  /* ---------- Kontaktkarte ---------- */
  .aud-contact {
    overflow: hidden;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(20, 22, 25, .12);
  }
  .aud-contact__photo {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--hrr-sand);
  }
  .aud-contact__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(.2, .7, .2, 1);
  }
  .aud-contact:hover .aud-contact__photo img { transform: scale(1.03); }
  .aud-contact__body { padding: 1.8rem 1.75rem 2rem; }
  .aud-contact__title {
    margin: 0 0 .3rem;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--hrr-ink);
  }
  .aud-contact__link {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    font-weight: 600;
    color: var(--hrr-ink);
    transition: color .3s ease;
  }
  .aud-contact__link :global(svg) { color: var(--hrr-orange); }
  .aud-contact__link:hover { color: var(--hrr-orange); }

  /* ---------- Stärken ---------- */
  .aud-strength {
    padding: 1.9rem 1.75rem;
    border-radius: 20px;
    background: var(--hrr-sand);
  }
  .aud-strength__icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-bottom: 1.2rem;
    border-radius: 14px;
    background: #fff;
    color: var(--hrr-orange);
    box-shadow: 0 8px 20px rgba(20, 22, 25, .06);
  }
  .aud-strength__title {
    margin: 0 0 .45rem;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--hrr-ink);
  }
</style>
