---
import { Icon } from "astro-icon/components";
import { CONTACT, IMAGES } from "../../consts";
---

<section class="hrr-hero no-reveal relative bg-white">
  <!-- 1. Teamfoto über die ganze Breite, Menü liegt durchsichtig darüber -->
  <div class="hrr-hero__media">
    <div class="hrr-hero__parallax" id="hero-parallax">
      <!-- Unscharfe Kopie füllt die Ränder um das Foto -->
      <img src={IMAGES.team.src} alt="" aria-hidden="true" class="hrr-hero__bg" loading="eager" decoding="async"
        onerror={`this.onerror=null;this.src='${IMAGES.team.fallback}'`} />
      <!-- Das Teamfoto selbst wird immer vollständig gezeigt -->
      <img
        src={IMAGES.team.src}
        alt={IMAGES.team.alt}
        class="hrr-hero__img"
        width="2400"
        height="1920"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        onerror={`this.onerror=null;this.src='${IMAGES.team.fallback}'`}
      />
    </div>
    <div class="hrr-hero__top" aria-hidden="true"></div>
    <div class="hrr-hero__fade" aria-hidden="true"></div>
  </div>

  <!-- 2. Danach der Text, er wächst aus dem Übergang heraus -->
  <div class="site-shell relative z-10 -mt-20 pb-20 text-center md:-mt-28 md:pb-28">
    <h1 class="hrr-hero__in hrr-hero__title" style="--d: .35s">
      H-R-R Facility <span class="text-[var(--hrr-orange)]">GmbH</span>
    </h1>

    <p class="hrr-hero__in hrr-hero__kicker" style="--d: .5s">Seit über 20 Jahren für Sie im Einsatz</p>

    <div class="hrr-hero__in hrr-hero__line" style="--d: .62s" aria-hidden="true"></div>

    <p class="hrr-hero__in hrr-hero__sub" style="--d: .72s">
      Professioneller Reinigungsdienst &amp; Hauswartung in Kreuzlingen, Winterthur und im Kanton Thurgau
    </p>

    <div class="hrr-hero__in mt-10 flex flex-col justify-center gap-3 sm:flex-row" style="--d: .86s">
      <a href="/contact" class="btn-main">Kostenlose Offerte anfragen <Icon name="lucide:arrow-right" size={18} /></a>
      <a href={CONTACT.phoneHref} class="btn-line"><Icon name="lucide:phone" size={18} /> {CONTACT.phone}</a>
    </div>

    <ul class="hrr-hero__in hrr-hero__facts" style="--d: 1s">
      <li><b>20+</b><span>Jahre Erfahrung</span></li>
      <li><b>24/7</b><span>erreichbar bei Notfällen</span></li>
      <li><b>4</b><span>Bereiche, ein Team</span></li>
    </ul>
  </div>
</section>

<style>
  /* ---------- Foto ---------- */
  /* Handy: Foto in voller Breite und ganzer Höhe, darüber etwas Platz für das Menü,
     damit kein Kopf unter dem Menü verschwindet */
  .hrr-hero__media {
    position: relative;
    height: calc(80vw + 72px);
    overflow: hidden;
    background: #e8e8e6;
  }

  .hrr-hero__parallax {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  .hrr-hero__bg {
    position: absolute;
    inset: -60px;
    width: calc(100% + 120px);
    height: calc(100% + 120px);
    object-fit: cover;
    object-position: center 20%;
    filter: blur(32px) saturate(1.05);
    opacity: .85;
  }

  .hrr-hero__img {
    position: absolute;
    left: 50%;
    bottom: 0;
    height: calc(100% - 72px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: center bottom;
    translate: -50% 0;
    animation: heroZoom 3.2s cubic-bezier(.16, .8, .2, 1) both;
  }

  /* Tablet und Desktop: grosser Bereich, Foto ganz sichtbar, Seiten mit weicher Unschärfe gefüllt */
  @media (min-width: 768px) {
    .hrr-hero__media {
      height: 88svh;
      min-height: 560px;
      max-height: 980px;
    }
    .hrr-hero__parallax { inset: -5% 0 0 0; }
    .hrr-hero__img { height: 100%; }
    .hrr-hero__bg { object-position: center 30%; }

    /* Ränder des Fotos laufen weich in die Unschärfe aus */
    .hrr-hero__img {
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    }
  }

  /* Leichter dunkler Verlauf oben, fliesst in den Schleier hinter dem Menü über */
  .hrr-hero__top {
    position: absolute;
    inset: 0 0 auto 0;
    height: 30%;
    background: linear-gradient(
      to bottom,
      rgba(18, 20, 23, .32) 0%,
      rgba(18, 20, 23, .22) 25%,
      rgba(18, 20, 23, .11) 50%,
      rgba(18, 20, 23, .04) 75%,
      rgba(18, 20, 23, 0) 100%
    );
  }

  /* Langer, weicher Übergang ins Weiss (viele Stufen = keine sichtbaren Kanten) */
  .hrr-hero__fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 42%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, .013) 8%,
      rgba(255, 255, 255, .049) 15%,
      rgba(255, 255, 255, .104) 22%,
      rgba(255, 255, 255, .175) 29%,
      rgba(255, 255, 255, .259) 35%,
      rgba(255, 255, 255, .352) 41%,
      rgba(255, 255, 255, .45) 47%,
      rgba(255, 255, 255, .55) 53%,
      rgba(255, 255, 255, .648) 59%,
      rgba(255, 255, 255, .741) 65%,
      rgba(255, 255, 255, .825) 71%,
      rgba(255, 255, 255, .896) 78%,
      rgba(255, 255, 255, .951) 85%,
      rgba(255, 255, 255, .987) 92%,
      #fff 100%
    );
  }

  /* ---------- Text ---------- */
  .hrr-hero__title {
    margin: 0 auto;
    font-size: clamp(44px, 8.4vw, 112px);
    line-height: .98;
    letter-spacing: -0.04em;
    font-weight: 800;
  }

  .hrr-hero__kicker {
    margin-top: 1.1rem;
    font-family: var(--font-head);
    font-size: clamp(13px, 1.2vw, 15px);
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--hrr-orange);
  }

  .hrr-hero__line {
    width: 80px;
    height: 3px;
    margin: 1.6rem auto 1.5rem;
    border-radius: 3px;
    background: var(--hrr-orange);
    transform-origin: center;
  }

  .hrr-hero__sub {
    max-width: 44rem;
    margin: 0 auto;
    font-family: var(--font-head);
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 500;
    line-height: 1.4;
    color: var(--hrr-text);
  }

  .hrr-hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 44rem;
    margin: 3.5rem auto 0;
    border-top: 1px solid var(--hrr-line);
  }
  .hrr-hero__facts li {
    padding: 1.6rem .5rem 0;
  }
  .hrr-hero__facts li + li { border-left: 1px solid var(--hrr-line); }
  .hrr-hero__facts b {
    display: block;
    font-family: var(--font-head);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
    line-height: 1;
    color: var(--hrr-ink);
  }
  .hrr-hero__facts span {
    display: block;
    margin-top: .45rem;
    font-size: .92rem;
    color: var(--hrr-muted);
  }

  /* ---------- Bewegung ---------- */
  .hrr-hero__in {
    animation: heroUp 1s cubic-bezier(.16, .8, .2, 1) both;
    animation-delay: var(--d, 0s);
  }
  .hrr-hero__line.hrr-hero__in { animation-name: heroLine; }

  @keyframes heroZoom {
    from { scale: 1.08; opacity: 0; }
    to   { scale: 1; opacity: 1; }
  }
  @keyframes heroUp {
    from { transform: translateY(22px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  @keyframes heroLine {
    from { transform: scaleX(0); opacity: 0; }
    to   { transform: scaleX(1); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hrr-hero__img, .hrr-hero__in { animation: none; }
  }
</style>

<script>
  // Leichter Tiefeneffekt: Foto scrollt etwas langsamer als die Seite (nur auf grossen Bildschirmen)
  const layer = document.getElementById("hero-parallax");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wide = window.matchMedia("(min-width: 768px)").matches;
  if (layer && !calm && wide) {
    let ticking = false;
    const move = () => {
      const y = Math.min(window.scrollY, window.innerHeight);
      layer.style.transform = `translate3d(0, ${y * 0.25}px, 0)`;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(move);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
