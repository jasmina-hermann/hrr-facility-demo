---
import { Icon } from "astro-icon/components";
import { CONTACT, IMAGES } from "../../consts";
---

<section class="bg-white">
  <div class="site-shell grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:py-20">
    <div>
      <span class="eyebrow">H-R-R Facility GmbH</span>
      <h1>Wir halten Ihre Liegenschaft sauber und in Schuss.</h1>
      <p class="lead max-w-xl">
        Reinigung, Hauswartung, Renovierungsarbeiten und Gartenunterhalt aus einer Hand –
        für Verwaltungen, Unternehmen und Privathaushalte in Kreuzlingen, Winterthur und Umgebung.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-main">Offerte anfragen <Icon name="lucide:arrow-right" size={18} /></a>
        <a href={CONTACT.phoneHref} class="btn-line"><Icon name="lucide:phone" size={18} /> {CONTACT.phone}</a>
      </div>

      <ul class="mt-10 grid gap-4 border-t border-[var(--hrr-line)] pt-6 sm:grid-cols-3">
        <li>
          <b class="num">20+ Jahre</b>
          <span class="text-sm text-[var(--hrr-muted)]">Erfahrung im Facility Service</span>
        </li>
        <li>
          <b class="num">24/7</b>
          <span class="text-sm text-[var(--hrr-muted)]">erreichbar bei Notfällen</span>
        </li>
        <li>
          <b class="num">1 Ansprechpartner</b>
          <span class="text-sm text-[var(--hrr-muted)]">für alle Arbeiten rund ums Haus</span>
        </li>
      </ul>
    </div>

    <div class="photo aspect-[4/3] lg:aspect-[5/6]">
      <img src={IMAGES.hero.src} alt={IMAGES.hero.alt} loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>
