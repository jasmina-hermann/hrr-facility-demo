---
import { Image } from "astro:assets";
---

<section class="relative overflow-hidden bg-[#fbfaf8] py-14 lg:py-24">
  <Image
    src="/img/bg/bg0.webp"
    alt="H-R-R Facility Reinigung und Hauswartung"
    width={1600}
    height={900}
    loading="eager"
    fetchpriority="high"
    format="webp"
    quality={70}
    class="absolute inset-y-0 right-0 w-full lg:w-[58%] h-full object-cover object-top"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-[#fbfaf8] via-[#fbfaf8]/95 to-[#fbfaf8]/35 lg:to-transparent"></div>
  <div class="absolute -left-24 top-8 h-72 w-72 rounded-full bg-[#ef8b2c]/10 blur-3xl"></div>

  <div class="container relative z-10">
    <div class="max-w-3xl py-8 lg:py-16">
      <div class="inline-flex items-center gap-3 rounded-full border border-[#ef8b2c]/25 bg-white/80 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-[#b9671b] shadow-sm backdrop-blur">
        H-R-R Facility GmbH
      </div>
      <h1 class="mt-6 max-w-3xl">Reinigung & Hauswartung auf höchstem Niveau.</h1>
      <p class="max-w-2xl text-lg md:text-xl leading-relaxed text-[#67625d]">
        Persönliche Betreuung, kompromisslose Sauberkeit und zuverlässiger Immobilienservice für Privat- und Geschäftskunden.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#dienstleistungen" class="inline-flex items-center justify-center rounded-full bg-[#ef8b2c] px-7 py-3.5 font-semibold text-white shadow-[0_12px_30px_rgba(239,139,44,0.28)] transition hover:-translate-y-0.5 hover:bg-[#df7c1e]">Dienstleistungen entdecken</a>
        <a href="/contact" class="inline-flex items-center justify-center rounded-full border border-[#d9d1c8] bg-white/90 px-7 py-3.5 font-semibold text-[#292929] transition hover:border-[#ef8b2c] hover:text-[#b9671b]">Offerte anfragen</a>
      </div>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-[#6d6862]">
        <span>✓ Privat & Geschäftlich</span>
        <span>✓ Kreuzlingen</span>
        <span>✓ Winterthur</span>
      </div>
    </div>
  </div>
</section>
