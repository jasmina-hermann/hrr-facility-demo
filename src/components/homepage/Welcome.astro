---
import { Icon } from "astro-icon/components";
import { IMAGES } from "../../consts";

const reasons = [
  {
    title: "Ein Ansprechpartner für alles",
    points: [
      "Reinigung und Hauswartung aus einer Hand",
      "Persönliche Betreuung und klare Kommunikation",
      "Kurze Wege bei Fragen und Anliegen",
    ],
  },
  {
    title: "Planung, auf die Sie zählen können",
    points: [
      "Transparente Absprachen und klare Offerten",
      "Zuverlässige und termingerechte Ausführung",
      "Flexible Einsätze – auch kurzfristig",
    ],
  },
  {
    title: "Erfahrenes Team",
    points: [
      "Über 20 Jahre Erfahrung im Facility Service",
      "Eingespielte Abläufe und feste Teams",
    ],
  },
  {
    title: "Qualität, die bleibt",
    points: [
      "Professionelle Geräte und Reinigungsmittel",
      "Fokus auf Werterhalt und langfristige Betreuung",
    ],
  },
];
---

<!-- Zielgruppen -->
<section class="section bg-white">
  <div class="site-shell">
    <div class="max-w-2xl">
      <span class="eyebrow">Für wen wir arbeiten</span>
      <h2>Für Liegenschaften und Privathaushalte</h2>
      <p class="lead">Wählen Sie den passenden Einstieg – wir beraten Sie gerne persönlich.</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-[10px] border border-[var(--hrr-line)] p-7 md:p-9">
        <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-[var(--hrr-orange-soft)] text-[var(--hrr-orange)]">
          <Icon name="lucide:building-2" size={24} />
        </div>
        <h3>Liegenschaften &amp; Unternehmen</h3>
        <p class="text-[var(--hrr-muted)]">Für Verwaltungen, Eigentümer, Unternehmen und Gewerbeobjekte. Wir übernehmen die Betreuung Ihres Objekts:</p>
        <ul class="check-list mt-4">
          <li>Treppenhaus-, Büro- und Gewerbereinigung</li>
          <li>Hauswartung und Kontrollgänge</li>
          <li>Umgebungspflege und Winterdienst</li>
        </ul>
        <a href="/hauswartung#geschaeftlich" class="btn-line mt-7">Mehr für Liegenschaften</a>
      </div>

      <div class="rounded-[10px] border border-[var(--hrr-line)] p-7 md:p-9">
        <div class="mb-5 grid h-12 w-12 place-items-center rounded-lg bg-[var(--hrr-orange-soft)] text-[var(--hrr-orange)]">
          <Icon name="lucide:house" size={24} />
        </div>
        <h3>Privathaushalte</h3>
        <p class="text-[var(--hrr-muted)]">Für Wohnungen, Häuser, Eigentümer und Mieter. Gerne übernehmen wir für Sie:</p>
        <ul class="check-list mt-4">
          <li>Regelmässige Wohnungsreinigung</li>
          <li>Umzugs- und Endreinigung mit Abgabe</li>
          <li>Hauswartungs- und Gartenarbeiten</li>
        </ul>
        <a href="/reinigung#privat" class="btn-line mt-7">Mehr für Privathaushalte</a>
      </div>
    </div>
  </div>
</section>

<!-- Warum H-R-R -->
<section class="section section-sand">
  <div class="site-shell grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
    <div class="lg:sticky lg:top-32">
      <span class="eyebrow">Warum H-R-R?</span>
      <h2>Rundum betreut – mit einem Ansprechpartner</h2>
      <p class="lead mb-8">Wir arbeiten so, wie wir es selbst von einem Partner erwarten würden: verlässlich, sauber und unkompliziert.</p>
      <div class="photo aspect-[4/3]">
        <img src={IMAGES.hauswart.src} alt={IMAGES.hauswart.alt} loading="lazy" />
      </div>
    </div>

    <div class="grid gap-5">
      {reasons.map((r, i) => (
        <div class="rounded-[10px] bg-white p-6 md:p-7">
          <div class="flex items-baseline gap-4">
            <span class="font-semibold text-[var(--hrr-orange)]">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{r.title}</h3>
              <ul class="check-list mt-3 text-[var(--hrr-muted)]">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Bildband -->
<section class="relative">
  <div class="h-[280px] md:h-[380px] overflow-hidden bg-[var(--hrr-sand)]">
    <img src={IMAGES.liegenschaft.src} alt={IMAGES.liegenschaft.alt} loading="lazy" class="h-full w-full object-cover" />
  </div>
</section>
