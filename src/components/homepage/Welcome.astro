---
import { Icon } from "astro-icon/components";

const groups = [
  {
    icon: "lucide:building-2",
    title: "Liegenschaften & Unternehmen",
    text: "Für Verwaltungen, Eigentümer, Firmen und Gewerbe. Wir betreuen Ihr Objekt mit einem festen Team.",
    points: [
      "Treppenhaus-, Büro- und Gewerbereinigung",
      "Hauswartung mit festen Kontrollgängen",
      "Instandstellung beim Mieterwechsel",
      "Umgebungspflege und Winterdienst",
    ],
    href: "/hauswartung#geschaeftlich",
    cta: "Mehr für Liegenschaften",
  },
  {
    icon: "lucide:house",
    title: "Privathaushalte",
    text: "Für Wohnungen und Häuser, ob Eigentum oder Miete. Einmalig oder regelmässig, wie es für Sie passt.",
    points: [
      "Regelmässige Wohnungsreinigung",
      "Umzugsreinigung mit Abgabe",
      "Kleine Renovationen",
      "Gartenpflege",
    ],
    href: "/reinigung#privat",
    cta: "Mehr für Privathaushalte",
  },
];
---

<section class="audience relative bg-white">
  <!-- Weicher, geschwungener Übergang nach oben -->
  <svg class="audience__curve audience__curve--top" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0H1440V30C1160 120 280 120 0 30Z" fill="#fff"></path>
  </svg>

  <div class="audience__body">
    <div class="audience__glow" aria-hidden="true"></div>

    <div class="site-shell relative py-24 md:py-32">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="eyebrow">Für wen wir arbeiten</span>
        <h2 class="!text-white">Für Liegenschaften und Privathaushalte</h2>
        <p class="lead !text-white/70">
          Ob Verwaltung mit zwanzig Wohnungen oder Einfamilienhaus: Wir richten den Einsatz nach Ihrem Objekt.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-2" data-stagger>
        {groups.map((g) => (
          <div class="flex">
            <article class="audience__card group">
              <div class="flex items-center gap-4">
                <span class="audience__icon"><Icon name={g.icon} size={26} /></span>
                <h3 class="!mb-0 !text-white">{g.title}</h3>
              </div>
              <p class="mt-5 text-white/70">{g.text}</p>
              <ul class="check-list mt-6 text-white/90">
                {g.points.map((p) => <li>{p}</li>)}
              </ul>
              <a href={g.href} class="btn-main mt-9 self-start">
                {g.cta} <Icon name="lucide:arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            </article>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Weicher, geschwungener Übergang nach unten -->
  <svg class="audience__curve audience__curve--bottom" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120H1440V90C1160 0 280 0 0 90Z" fill="#fff"></path>
  </svg>
</section>

<style>
  .audience__body {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #2a2e33 0%, #1d2024 55%, #24211e 100%);
  }

  /* Warmer Lichtschein in Orange */
  .audience__glow {
    position: absolute;
    width: 900px;
    height: 900px;
    left: 50%;
    top: -340px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 118, 26, .22) 0%, rgba(232, 118, 26, .06) 40%, transparent 70%);
    pointer-events: none;
  }

  .audience__curve {
    position: absolute;
    left: 0;
    width: 100%;
    height: clamp(40px, 7vw, 110px);
    z-index: 2;
    display: block;
  }
  .audience__curve--top { top: -1px; }
  .audience__curve--bottom { bottom: -1px; }

  .audience__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 2.2rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, .1);
    background: linear-gradient(180deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .03));
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), border-color .5s ease, background .5s ease;
  }
  @media (min-width: 768px) {
    .audience__card { padding: 2.8rem; }
  }
  .audience__card:hover {
    transform: translateY(-6px);
    border-color: rgba(232, 118, 26, .55);
    background: linear-gradient(180deg, rgba(255, 255, 255, .1), rgba(255, 255, 255, .04));
  }

  .audience__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 14px;
    background: var(--hrr-orange);
    color: #fff;
    box-shadow: 0 12px 30px rgba(232, 118, 26, .35);
  }
</style>
