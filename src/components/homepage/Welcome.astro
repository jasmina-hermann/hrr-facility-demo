---
// Privat & Geschäftlich: zwei grosse Karten mit Farbverlauf plus Button zum Offertenformular
import { Icon } from "astro-icon/components";

const groups = [
  {
    headline: "Ihr Zuhause. Unsere Sorgfalt.",
    intro: "Wir kümmern uns um Sauberkeit und Unterhalt, damit Sie mehr Zeit für die wichtigen Dinge haben.",
    title: "Privat",
    text: "Für Wohnungen, Häuser und Gärten.",
    icon: "lucide:house",
    tone: "warm",
    href: "/privat",
  },
  {
    headline: "Ihr Betrieb. Unsere Verantwortung.",
    intro: "Wir halten Büro und Liegenschaft in Ordnung, damit Sie sich auf Ihr Kerngeschäft konzentrieren können.",
    title: "Geschäftlich",
    text: "Für Verwaltungen, Firmen und Gewerbe.",
    icon: "lucide:building-2",
    tone: "deep",
    href: "/geschaeftlich",
  },
];
---

<section class="audience relative bg-white">
  <!-- Weicher, geschwungener Übergang nach oben -->
  <svg class="audience__curve audience__curve--top" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0H1440V30C1160 120 280 120 0 30Z" fill="#fff"></path>
  </svg>

  <div class="audience__body">
    <div class="audience__glow" aria-hidden="true"></div>

    <div class="site-shell relative py-24 md:py-32">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-8" data-stagger>
        {groups.map((g) => (
          <div class="flex flex-col">
            <div class="mx-auto max-w-md text-center">
              <h2 class="audience__headline">{g.headline}</h2>
              <p class="mt-4 text-white/75">{g.intro}</p>
            </div>

            <a href={g.href} class:list={["audience__card group mt-8", `audience__card--${g.tone}`]}>
              <div class="audience__shine" aria-hidden="true"></div>
              <span class="audience__watermark" aria-hidden="true"><Icon name={g.icon} size={220} /></span>
              <div class="audience__content">
                <span class="audience__badge"><Icon name={g.icon} size={28} /></span>
                <h3 class="audience__title">{g.title}</h3>
                <p class="text-white/85">{g.text}</p>
                <span class="audience__more">
                  Mehr erfahren
                  <Icon name="lucide:arrow-right" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          </div>
        ))}
      </div>

      <div class="mt-14 text-center" data-reveal>
        <a href="/contact" class="audience__cta">
          Offertenformular <Icon name="lucide:arrow-right" size={18} />
        </a>
        <p class="mt-4 text-sm text-white/60">Kostenlos und unverbindlich. Wir melden uns persönlich.</p>
      </div>
    </div>
  </div>

  <!-- Weicher, geschwungener Übergang nach unten -->
  <svg class="audience__curve audience__curve--bottom" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120H1440V90C1160 0 280 0 0 90Z" fill="#fff"></path>
  </svg>
</section>

<style>
  .audience__body {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #2a2e33 0%, #1d2024 55%, #24211e 100%);
  }

  /* Warmer Lichtschein in Orange */
  .audience__glow {
    position: absolute;
    width: 1000px;
    height: 1000px;
    left: 50%;
    top: -380px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 118, 26, .22) 0%, rgba(232, 118, 26, .06) 40%, transparent 70%);
    pointer-events: none;
  }

  .audience__curve {
    position: absolute;
    left: 0;
    width: 100%;
    height: clamp(40px, 7vw, 110px);
    z-index: 2;
    display: block;
  }
  .audience__curve--top { top: -1px; }
  .audience__curve--bottom { bottom: -1px; }

  .audience__headline {
    margin: 0;
    color: #fff;
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  /* Grosse Karte mit Farbverlauf */
  .audience__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 380px;
    overflow: hidden;
    border-radius: 22px;
    background-size: 160% 160%;
    background-position: 0% 0%;
    box-shadow: 0 30px 60px rgba(0, 0, 0, .3);
    transition: transform .6s cubic-bezier(.2, .7, .2, 1), box-shadow .6s ease, background-position 1.2s ease;
  }
  .audience__card--warm {
    background-image: linear-gradient(135deg, #F8A24C 0%, #E8761A 45%, #B8520C 100%);
  }
  .audience__card--deep {
    background-image: linear-gradient(135deg, #E8761A 0%, #A9480E 50%, #5E2A0D 100%);
  }
  .audience__card:hover {
    transform: translateY(-8px);
    background-position: 100% 100%;
    box-shadow: 0 40px 80px rgba(0, 0, 0, .38);
  }

  /* Weicher Lichtschein oben rechts */
  .audience__shine {
    position: absolute;
    width: 420px;
    height: 420px;
    right: -120px;
    top: -160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, .35) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
  }

  /* Grosses, fast durchsichtiges Symbol im Hintergrund */
  .audience__watermark {
    position: absolute;
    right: -30px;
    bottom: -40px;
    color: rgba(255, 255, 255, .1);
    transition: transform 1.2s cubic-bezier(.2, .7, .2, 1);
    pointer-events: none;
  }
  .audience__card:hover .audience__watermark { transform: rotate(-6deg) scale(1.05); }

  .audience__content {
    position: relative;
    padding: 2.5rem 1.5rem 2.5rem;
    text-align: center;
  }
  .audience__badge {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 1.2rem;
    border-radius: 18px;
    background: rgba(255, 255, 255, .18);
    border: 1px solid rgba(255, 255, 255, .35);
    color: #fff;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .audience__title {
    margin: 0 0 .4rem;
    font-size: clamp(36px, 3.8vw, 50px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .audience__more {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-top: 1.4rem;
    padding: .7rem 1.4rem;
    border-radius: 999px;
    background: #fff;
    color: var(--hrr-orange-dark);
    font-family: var(--font-head);
    font-weight: 700;
    transition: background-color .3s ease;
  }
  .audience__card:hover .audience__more { background: #FFF4EA; }

  /* Button zum Offertenformular */
  .audience__cta {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    padding: 1.05rem 2.2rem;
    border-radius: 999px;
    background: var(--hrr-orange);
    color: #fff;
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    box-shadow: 0 16px 36px rgba(232, 118, 26, .4);
    transition: background-color .3s ease, transform .3s ease, box-shadow .3s ease;
  }
  .audience__cta:hover {
    background: var(--hrr-orange-dark);
    transform: translateY(-2px);
    box-shadow: 0 22px 44px rgba(232, 118, 26, .5);
  }
</style>
