---
import { Icon } from "astro-icon/components";
import { CONTACT } from "../../consts";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Kontaktieren Sie uns",
  text = "Rufen Sie uns an oder schreiben Sie uns kurz, worum es geht. Wir melden uns persönlich bei Ihnen – auch für eine Besichtigung vor Ort.",
} = Astro.props;
---

<section class="bg-[var(--hrr-ink)] text-white">
  <div class="site-shell grid gap-10 py-16 md:py-20 lg:grid-cols-[1.2fr_1fr] lg:items-center">
    <div>
      <span class="eyebrow">Wir freuen uns auf Sie</span>
      <h2 class="!text-white">{title}</h2>
      <p class="max-w-xl text-lg text-white/75">{text}</p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <a href="/contact" class="btn-main sm:col-span-2">Kontakt aufnehmen <Icon name="lucide:arrow-right" size={18} /></a>
      <a href={CONTACT.phoneHref} class="btn-light"><Icon name="lucide:phone" size={18} /> Anrufen</a>
      <a href={CONTACT.emailHref} class="btn-light"><Icon name="lucide:mail" size={18} /> E-Mail senden</a>
      <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn-light sm:col-span-2"><Icon name="lucide:message-circle" size={18} /> WhatsApp {CONTACT.mobile}</a>
    </div>
  </div>
</section>
