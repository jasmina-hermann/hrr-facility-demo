---
import { Icon } from "astro-icon/components";
import { IMAGES } from "../../consts";

const services = [
  {
    title: "Reinigung",
    text: "Regelmässige und einmalige Reinigungen für Liegenschaften, Büros und Privathaushalte.",
    points: ["Treppenhaus- und Büroreinigung", "Fenster- und Grundreinigung", "Umzugs- und Baureinigung"],
    img: IMAGES.treppenhaus,
    href: "/reinigung",
  },
  {
    title: "Hauswartung",
    text: "Zuverlässige Betreuung, damit in Ihrer Liegenschaft alles funktioniert.",
    points: ["Regelmässige Kontrollgänge", "Kleine Reparaturen", "Ansprechpartner für Mieter"],
    img: IMAGES.hauswart,
    href: "/hauswartung",
  },
  {
    title: "Renovierungsarbeiten",
    text: "Kleine Renovierungen und Instandsetzungen – sauber geplant und ausgeführt.",
    points: ["Kleine Renovierungen", "Bau- und Sanierungsprojekte", "Innenausbau und Umbauten"],
    img: IMAGES.bohren,
    href: "/renovation",
  },
  {
    title: "Gartenunterhalt",
    text: "Gepflegte Aussenbereiche – die Visitenkarte Ihres Hauses.",
    points: ["Rasen-, Hecken- und Strauchpflege", "Plätze und Wege", "Winterdienst"],
    img: IMAGES.garten,
    href: "/garten",
  },
];
---

<section id="dienstleistungen" class="section section-sand">
  <div class="site-shell">
    <div class="max-w-2xl">
      <span class="eyebrow">Dienstleistungen</span>
      <h2>Ihr Partner für Innen- und Aussenbereiche</h2>
      <p class="lead">
        Ob kleine oder grosse Arbeiten: Mit erfahrenen Mitarbeitenden und modernen Geräten sind wir
        für die unterschiedlichsten Aufgaben gerüstet.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {services.map((s) => (
        <article class="flex flex-col overflow-hidden rounded-[10px] border border-[var(--hrr-line)] bg-white">
          <div class="aspect-[4/3] overflow-hidden bg-[var(--hrr-sand)]">
            <img src={s.img.src} alt={s.img.alt} loading="lazy" class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3>{s.title}</h3>
            <p class="text-[var(--hrr-muted)]">{s.text}</p>
            <ul class="check-list mt-4 mb-6 text-[15px]">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
            <a href={s.href} class="mt-auto inline-flex items-center gap-2 font-semibold text-[var(--hrr-orange)] hover:text-[var(--hrr-orange-dark)]">
              Mehr erfahren <Icon name="lucide:arrow-right" size={17} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
