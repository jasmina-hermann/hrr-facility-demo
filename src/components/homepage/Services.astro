---
import { Icon } from "astro-icon/components";
import { IMAGES } from "../../consts";

const services = [
  {
    title: "Reinigung",
    text: "Treppenhäuser, Büros und Wohnungen reinigen wir nach festem Plan. Dazu kommen Fenster, Grund-, Umzugs- und Baureinigungen.",
    points: ["Treppenhaus und Büro", "Fenster und Grundreinigung", "Umzugsreinigung mit Abgabe"],
    img: IMAGES.reinigung,
    href: "/reinigung",
  },
  {
    title: "Hauswartung",
    text: "Wir sind regelmässig vor Ort, kontrollieren die Liegenschaft und erledigen kleine Reparaturen gleich selbst.",
    points: ["Kontrollgänge nach Plan", "Kleine Reparaturen", "Ansprechperson für Mieter"],
    img: IMAGES.hauswartung,
    href: "/hauswartung",
  },
  {
    title: "Renovierungsarbeiten",
    text: "Kleinere Renovationen und Instandstellungen. Am Schluss reinigen wir selbst, damit alles bezugsbereit ist.",
    points: ["Kleine Renovationen", "Bau und Sanierung", "Innenausbau und Umbauten"],
    img: IMAGES.renovation,
    href: "/renovation",
  },
  {
    title: "Gartenunterhalt",
    text: "Rasen, Hecken, Beete und Wege pflegen wir das ganze Jahr. Im Winter räumen wir Schnee und streuen.",
    points: ["Rasen und Hecken", "Plätze und Wege", "Winterdienst"],
    img: IMAGES.garten,
    href: "/garten",
  },
];
---

<section id="dienstleistungen" class="section section-sand">
  <div class="site-shell">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Dienstleistungen</span>
      <h2>Was wir für Sie übernehmen</h2>
      <p class="lead">Vier Bereiche, ein Team. Sie haben eine Ansprechperson für alles rund um Ihre Liegenschaft.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4" data-stagger>
      {services.map((s, i) => (
        <div class="flex">
        <a href={s.href} class="service-card group">
          <div class="service-card__img">
            <img
              src={s.img.src}
              alt={s.img.alt}
              loading="lazy"
              style={`object-position: ${s.img.pos}`}
              onerror={`this.onerror=null;this.src='${s.img.fallback}'`}
            />
            <span class="service-card__num">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3>{s.title}</h3>
            <p class="text-[15px] text-[var(--hrr-muted)]">{s.text}</p>
            <ul class="check-list mt-4 mb-6 text-[15px]">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 font-semibold text-[var(--hrr-orange)]">
              Mehr erfahren
              <Icon name="lucide:arrow-right" size={17} class="transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </div>
        </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .service-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--hrr-line);
    background: #fff;
    box-shadow: 0 1px 2px rgba(20, 22, 25, .04);
    transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s ease, border-color .5s ease;
  }
  .service-card:hover {
    transform: translateY(-6px);
    border-color: rgba(232, 118, 26, .35);
    box-shadow: 0 24px 50px rgba(20, 22, 25, .10);
  }
  .service-card__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--hrr-sand);
  }
  .service-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(.2, .7, .2, 1);
  }
  .service-card:hover .service-card__img img { transform: scale(1.06); }
  .service-card__num {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: .3rem .6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, .92);
    font-family: var(--font-head);
    font-size: .8rem;
    font-weight: 700;
    color: var(--hrr-orange);
  }
</style>
