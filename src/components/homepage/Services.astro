---
import { Icon } from "astro-icon/components";
import { IMAGES } from "../../consts";

const services = [
  {
    title: "Unterhaltsreinigung",
    text: "Regelmässige Reinigung für Liegenschaften, Büros und Privathaushalte.",
    points: ["Treppenhausreinigung", "Büro- und Praxisreinigung", "Privathaushalte"],
    img: IMAGES.treppenhaus,
    href: "/reinigung",
  },
  {
    title: "Fenster- & Grundreinigung",
    text: "Gründliche Einsätze, wenn mehr als die tägliche Pflege gefragt ist.",
    points: ["Fensterreinigung", "Grundreinigung", "Umzugs- und Endreinigung"],
    img: IMAGES.fenster,
    href: "/reinigung#spezial",
  },
  {
    title: "Hauswartung",
    text: "Zuverlässige Betreuung, damit in Ihrer Liegenschaft alles funktioniert.",
    points: ["Regelmässige Kontrollgänge", "Kleine Reparaturen", "Haustechnik im Blick"],
    img: IMAGES.werkzeug,
    href: "/hauswartung",
  },
  {
    title: "Umgebungspflege",
    text: "Gepflegte Aussenbereiche – das ganze Jahr hindurch.",
    points: ["Rasen- und Heckenpflege", "Plätze und Wege", "Winterdienst"],
    img: IMAGES.garten,
    href: "/hauswartung#umgebung",
  },
];
---

<section id="dienstleistungen" class="section section-sand">
  <div class="site-shell">
    <div class="max-w-2xl">
      <span class="eyebrow">Dienstleistungen</span>
      <h2>Ihr Ansprechpartner für eine gepflegte Liegenschaft</h2>
      <p class="lead">
        Ob kleine oder grosse Arbeiten: Mit erfahrenen Mitarbeitenden und professionellem Material
        sind wir für die unterschiedlichsten Aufgaben gerüstet.
      </p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {services.map((s) => (
        <article class="flex flex-col overflow-hidden rounded-[10px] border border-[var(--hrr-line)] bg-white">
          <div class="aspect-[4/3] overflow-hidden bg-[var(--hrr-sand)]">
            <img src={s.img.src} alt={s.img.alt} loading="lazy" class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h3>{s.title}</h3>
            <p class="text-[var(--hrr-muted)]">{s.text}</p>
            <ul class="check-list mt-4 mb-6 text-[15px]">
              {s.points.map((p) => <li>{p}</li>)}
            </ul>
            <a href={s.href} class="mt-auto inline-flex items-center gap-2 font-semibold text-[var(--hrr-orange)] hover:text-[var(--hrr-orange-dark)]">
              Mehr erfahren <Icon name="lucide:arrow-right" size={17} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
