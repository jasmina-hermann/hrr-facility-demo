---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/og_1200x630.jpg";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL, CONTACT, LOCATIONS, SERVICES } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = SITE_DESCRIPTION,
  image = FallbackImage,
} = Astro.props;

// Suchbegriff zuerst, Firmenname am Schluss – so mag es Google
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const imageURL = new URL(image.src, Astro.url);

// Strukturierte Daten für Google (Firmenname, Adresse, Öffnungszeiten, Einsatzgebiet)
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${SITE_URL}/#firma`,
  name: SITE_TITLE,
  url: SITE_URL,
  logo: "https://le-de.cdn-website.com/987a3abca60a4d0682fee4826dac4603/dms3rep/multi/opt/H-R-R-Facility_logo-1920w.png",
  image: `${SITE_URL}/img/hrr-team.jpg`,
  description: SITE_DESCRIPTION,
  telephone: "+41716887851",
  email: CONTACT.email,
  priceRange: "CHF",
  address: {
    "@type": "PostalAddress",
    streetAddress: CONTACT.street,
    postalCode: "8274",
    addressLocality: "Tägerwilen",
    addressRegion: "TG",
    addressCountry: "CH",
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "07:30", closes: "17:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "08:30", closes: "12:00" },
  ],
  areaServed: LOCATIONS.flatMap((l) => l.places).map((name) => ({ "@type": "City", name })),
  knowsAbout: SERVICES.map((s) => s.title),
  sameAs: [CONTACT.instagram],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="de_CH" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
