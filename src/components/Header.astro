---
import Navabar from "../components/Navbar.astro";
import Logo from "../components/Logo.astro";
import { Icon } from "astro-icon/components";
---

<header class="header sticky top-0 z-50 border-b border-[#eee8e2] bg-white/95 backdrop-blur-xl">
  <div class="navbar w-full min-h-[82px] py-2">
    <div class="container grid grid-cols-[220px_1fr] lg:grid-cols-[220px_1fr_auto] items-center">
      <Logo />
      <Navabar />
      <div class="flex gap-3 ml-auto">
        <a href="/contact" class="hidden sm:inline-flex items-center gap-2 rounded-xl bg-[#ef7f1a] px-6 py-3 text-sm font-bold text-white shadow-[0_10px_25px_rgba(239,127,26,.22)] transition hover:-translate-y-0.5 hover:bg-[#da6f12]">
          Offerte anfragen <span>→</span>
        </a>
        <div class="flex-none lg:hidden">
          <label for="my-drawer-2" aria-label="Menü öffnen" class="btn btn-square btn-ghost ml-2">
            <Icon name="lucide:menu" />
          </label>
        </div>
      </div>
    </div>
  </div>
</header>
