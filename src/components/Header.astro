---
import Navbar from "./Navbar.astro";
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import { CONTACT } from "../consts";

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
---

<header
  id="site-header"
  class:list={["site-header z-50 bg-white", transparent ? "header-transparent" : "sticky top-0"]}
  data-transparent={transparent ? "true" : undefined}
>
  <div class="header-bar border-b border-[var(--hrr-line)]">
    <div class="site-shell flex h-[80px] items-center justify-between gap-6">
      <Logo />
      <Navbar />
      <div class="flex items-center gap-2">
        <a href={CONTACT.phoneHref} class="header-call btn-line hidden xl:inline-flex">
          <Icon name="lucide:phone" size={17} /> {CONTACT.phone}
        </a>
        <a href="/contact" class="btn-main hidden sm:inline-flex">Offerte anfragen</a>
        <label for="my-drawer-2" aria-label="Menü öffnen" class="menu-toggle btn btn-square btn-ghost lg:hidden">
          <Icon name="lucide:menu" size={26} />
        </label>
      </div>
    </div>
  </div>
</header>

<script>
  // Durchsichtiger Header: bleibt über dem ganzen Foto durchsichtig
  // und wird erst weiss, wenn das Foto fast vorbei ist.
  const header = document.getElementById("site-header");
  if (header?.dataset.transparent === "true") {
    const media = document.querySelector<HTMLElement>(".hrr-hero__media");
    const limit = () => (media ? media.offsetHeight * 0.8 - header.offsetHeight : 60);
    const update = () => header.classList.toggle("is-scrolled", window.scrollY > limit());
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
