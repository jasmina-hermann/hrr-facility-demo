---
import Layout from "../layouts/Main.astro";
---

<Layout title="Seite nicht gefunden">
  <section class="section bg-white">
    <div class="site-shell"><div class="mx-auto max-w-xl text-center">
      <span class="eyebrow">Fehler 404</span>
      <h1>Diese Seite gibt es leider nicht.</h1>
      <p class="lead">Vielleicht hat sich die Adresse geändert. Auf der Startseite finden Sie alle Dienstleistungen.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-main">Zur Startseite</a>
        <a href="/contact" class="btn-line">Kontakt</a>
      </div>
    </div></div>
  </section>
</Layout>
