---
import Layout from "../layouts/Main.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="Seite nicht gefunden">
  <PageHero
    kicker="Fehler 404"
    title="Seite nicht gefunden"
    text="Diese Adresse gibt es leider nicht mehr."
    icon="lucide:search"
  />

  <section class="section bg-white">
    <div class="site-shell">
      <p class="lead">Auf der Startseite finden Sie alle Dienstleistungen.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn-main">Zur Startseite</a>
        <a href="/contact" class="btn-line">Kontakt</a>
      </div>
    </div>
  </section>
</Layout>
