---
import Layout from "../layouts/Main.astro";
import PageHero from "../components/PageHero.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import Steps from "../components/Steps.astro";
import Contacts from "../components/homepage/Contacts.astro";
---

<Layout
  title="Reinigung"
  description="Unterhaltsreinigung, Büroreinigung, Fenster-, Grund- und Umzugsreinigung in Kreuzlingen, Winterthur und Umgebung."
>
  <PageHero
    kicker="Dienstleistungen"
    title="Reinigung"
    text="Treppenhaus, Büro, Wohnung und Fenster."
    icon="lucide:sparkles"
  />

  <ServiceBlock
    id="geschaeftlich"
    eyebrow="Geschäftlich"
    title="Treppenhaus-, Büro- und Gewerbereinigung"
    text="Für Verwaltungen, Unternehmen, Praxen und Gewerbe. Wir reinigen nach festem Plan: täglich, wöchentlich oder in dem Rhythmus, der zu Ihrem Objekt passt."
    points={[
      "Treppenhausreinigung",
      "Büro- und Praxisreinigung",
      "Sanitär- und Küchenbereiche",
      "Eingangsbereiche und Lifte",
      "Abfallentsorgung",
      "Reinigung nach festem Plan",
    ]}
  />

  <ServiceBlock
    id="privat"
    eyebrow="Privat"
    title="Reinigung für Ihr Zuhause"
    text="Für Wohnungen und Häuser, regelmässig oder bei Bedarf. Sie bekommen feste Mitarbeitende, die Ihr Zuhause kennen."
    points={[
      "Wohnungs- und Hausreinigung",
      "Küche und Bad",
      "Böden und Teppiche",
      "Umzugsreinigung mit Abgabe",
    ]}
    reverse
    sand
  />

  <ServiceBlock
    id="spezial"
    eyebrow="Fenster & Grundreinigung"
    title="Wenn es gründlich sein muss"
    text="Für Einsätze, die über die normale Reinigung hinausgehen: nach Umbauten, beim Mieterwechsel oder einfach einmal im Jahr."
    points={[
      "Fenster und Rahmen",
      "Grundreinigung",
      "Bauendreinigung",
      "Umzugs- und Endreinigung",
    ]}
  />

  <Steps />
  <Contacts title="Offerte für Ihre Reinigung" />
</Layout>
