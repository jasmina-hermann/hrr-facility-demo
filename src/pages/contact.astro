---
import Layout from "../layouts/Main.astro";
---

<Layout title="Kontakt | H-R-R Facility GmbH">
  <main class="relative overflow-hidden bg-[#fbfaf8] py-12 md:py-16">
    <div class="pointer-events-none absolute -left-40 top-20 h-[34rem] w-[34rem] rounded-full bg-[#ef7f1a]/12 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-48 bottom-0 h-[30rem] w-[30rem] rounded-full bg-[#f8c28d]/18 blur-3xl"></div>

    <div class="container relative z-10">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 lg:grid-cols-[380px_1fr] lg:gap-20">
        <div class="relative flex justify-center">
          <div class="absolute inset-1/2 h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(239,127,26,.28),rgba(239,127,26,.08)_42%,transparent_70%)] blur-xl"></div>
          <div class="phone-mockup relative z-10">
            <div class="phone-notch"></div>
            <div class="phone-screen">
              <div class="px-6 pt-14 text-center">
                <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[#ef7f1a]">H-R-R 24/7 Service</p>
                <h1 class="!mt-3 !text-[28px] !leading-[1.05]">Direkt für Sie erreichbar.</h1>
              </div>
              <div class="mt-8 flex-1 px-5">
                <div class="message-bubble">Grüezi! 👋<br /><br />Wie dürfen wir Sie unterstützen? Reinigung, Hauswartung oder eine unverbindliche Offerte – kontaktieren Sie uns direkt über Ihren bevorzugten Kanal.</div>
              </div>
              <div class="grid grid-cols-3 gap-2 px-5 pb-6">
                <a href="tel:+41716887851" class="phone-mini">☎<small>Anruf</small></a>
                <a href="https://wa.me/41774805454" target="_blank" rel="noopener" class="phone-mini">◉<small>WhatsApp</small></a>
                <a href="mailto:Info@h-r-r.ch" class="phone-mini">✉<small>E-Mail</small></a>
              </div>
            </div>
          </div>
        </div>

        <div>
          <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.18em] text-[#ef7f1a]">Direkt erreichbar</p>
          <h2 class="max-w-2xl">Wie möchten Sie uns <span class="text-[#ef7f1a]">kontaktieren?</span></h2>
          <p class="mb-8 max-w-2xl text-lg leading-relaxed text-[#69635e]">Ein Klick verbindet Sie direkt mit H-R-R Facility. Für dringende Anliegen steht Ihnen unser 24/7-Service zur Verfügung.</p>

          <div class="grid gap-4 sm:grid-cols-2">
            <a href="https://wa.me/41774805454" target="_blank" rel="noopener" class="contact-card group"><span class="contact-icon bg-[#ef7f1a] text-white">◉</span><span><b>WhatsApp</b><small>077 480 54 54</small></span><span class="arrow">↗</span></a>
            <a href="tel:+41716887851" class="contact-card group"><span class="contact-icon bg-[#ef7f1a] text-white">☎</span><span><b>Telefon</b><small>071 688 78 51</small></span><span class="arrow">↗</span></a>
            <a href="tel:+41774805454" class="contact-card group"><span class="contact-icon bg-[#f3e7dc] text-[#ef7f1a]">24</span><span><b>24/7 Service</b><small>077 480 54 54</small></span><span class="arrow">↗</span></a>
            <a href="mailto:Info@h-r-r.ch" class="contact-card group"><span class="contact-icon bg-[#fff7ef] text-[#ef7f1a] border border-[#f1d4b6]">✉</span><span><b>E-Mail</b><small>Info@h-r-r.ch</small></span><span class="arrow">↗</span></a>
          </div>

          <div class="mt-7 rounded-2xl border border-[#e8e1da] bg-white/80 p-5 text-sm text-[#68635e] shadow-sm">
            <b class="text-[#292929]">H-R-R Facility GmbH</b><br />Hauptstrasse 137b · 8274 Tägerwilen<br /><span class="text-[#ef7f1a]">Region Kreuzlingen &amp; Winterthur</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .phone-mockup { width:min(310px,80vw); aspect-ratio:.51; border-radius:46px; padding:10px; background:linear-gradient(145deg,#d8c5b4,#8f6e50 48%,#ecd8c6); box-shadow:0 32px 70px rgba(64,44,25,.22),0 0 65px rgba(239,127,26,.14); animation:phoneFloat 5s ease-in-out infinite; }
  .phone-notch { position:absolute; top:16px; left:50%; transform:translateX(-50%); width:96px; height:25px; border-radius:20px; background:#7b5d45; z-index:3; }
  .phone-screen { height:100%; overflow:hidden; border-radius:37px; display:flex; flex-direction:column; background:linear-gradient(180deg,#fffaf5,#fff 56%,#f8f3ed); border:1px solid rgba(255,255,255,.7); }
  .message-bubble { border-radius:20px 20px 20px 6px; border:1px solid rgba(239,127,26,.22); background:linear-gradient(135deg,#fff4e9,#fff); color:#555; padding:18px; line-height:1.6; box-shadow:0 14px 28px rgba(76,52,28,.08); }
  .phone-mini { display:flex; min-width:0; flex-direction:column; align-items:center; justify-content:center; gap:4px; border-radius:12px; border:1px solid #ece3da; background:#fff; padding:9px 4px; color:#ef7f1a; font-weight:800; }
  .phone-mini small { font-size:9px; color:#777; font-weight:700; }
  .contact-card { min-height:92px; display:grid; grid-template-columns:54px 1fr auto; gap:14px; align-items:center; border:1px solid #e6dfd8; border-radius:18px; padding:16px; background:#fff; color:#292929; box-shadow:0 12px 34px rgba(70,49,31,.06); transition:.25s ease; }
  .contact-card:hover { transform:translateY(-3px); border-color:rgba(239,127,26,.55); box-shadow:0 18px 44px rgba(239,127,26,.12); }
  .contact-icon { width:52px; height:52px; border-radius:14px; display:grid; place-items:center; font-weight:800; }
  .contact-card b { display:block; font-size:1rem; }
  .contact-card small { display:block; margin-top:3px; color:#777; font-size:.82rem; }
  .arrow { color:#ef7f1a; font-size:1.4rem; transition:.25s ease; }
  .contact-card:hover .arrow { transform:translate(3px,-3px); }
  @keyframes phoneFloat { 0%,100%{transform:translateY(0) rotate(-1deg)} 50%{transform:translateY(-10px) rotate(1deg)} }
</style>
