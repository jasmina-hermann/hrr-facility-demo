---
import Layout from "../layouts/Main.astro";
---

<Layout title="Kontakt | H-R-R Facility GmbH">
  <main class="relative overflow-hidden bg-[#fbfaf8] py-16 md:py-24">
    <div class="pointer-events-none absolute -left-40 top-20 h-[34rem] w-[34rem] rounded-full bg-[#ef7f1a]/12 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-48 bottom-0 h-[30rem] w-[30rem] rounded-full bg-[#f8c28d]/18 blur-3xl"></div>

    <div class="container relative z-10">
      <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 lg:grid-cols-[380px_1fr] lg:gap-24">
        <div class="relative flex justify-center">
          <div class="absolute inset-1/2 h-[28rem] w-[28rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(239,127,26,.28),rgba(239,127,26,.08)_42%,transparent_70%)] blur-xl"></div>
          <div class="phone-mockup relative z-10">
            <div class="phone-notch"></div>
            <div class="phone-screen">
              <div class="px-6 pt-14 text-center">
                <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-[#ef7f1a]">H-R-R 24/7 Service</p>
                <h1 class="!mt-3 !text-[28px] !leading-[1.05]">Direkt für Sie erreichbar.</h1>
              </div>
              <div class="mt-8 flex-1 px-5">
                <div class="message-bubble">
                  Grüezi! 👋<br /><br />Wie dürfen wir Sie unterstützen? Reinigung, Hauswartung oder eine unverbindliche Offerte – kontaktieren Sie uns direkt über Ihren bevorzugten Kanal.
                </div>
              </div>
              <div class="grid grid-cols-3 gap-2 px-5 pb-6">
                <a href="tel:+41716887851" class="phone-mini">☎<small>Anruf</small></a>
                <a href="https://wa.me/41774805454" target="_blank" rel="noopener" class="phone-mini">◉<small>WhatsApp</small></a>
                <a href="mailto:Info@h-r-r.ch" class="phone-mini">✉<small>E-Mail</small></a>
              </div>
            </div>
          </div>
        </div>

        <div>
          <p class="mb-4 text-sm font-extrabold uppercase tracking-[0.18em] text-[#ef7f1a]">Direkt erreichbar</p>
          <h2 class="max-w-2xl">Wie möchten Sie uns <span class="text-[#ef7f1a]">kontaktieren?</span></h2>
          <p class="mb-9 max-w-2xl text-lg leading-relaxed text-[#69635e]">Ein Klick verbindet Sie direkt mit H-R-R Facility. Für dringende Anliegen steht Ihnen unser 24/7-Service zur Verfügung.</p>

          <div class="grid gap-4 sm:grid-cols-2">
            <a href="https://wa.me/41774805454" target="_blank" rel="noopener" class="contact-card group">
              <span class="contact-icon bg-[#25D366] text-white">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785a9.87 9.87 0 0 1-5.034-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 5.45 0 9.884 4.434 9.881 9.892-.003 5.45-4.437 9.884-9.886 9.884"/></svg>
              </span>
              <span><b>WhatsApp</b><small>077 480 54 54</small></span><span class="arrow">↗</span>
            </a>

            <a href="tel:+41716887851" class="contact-card group">
              <span class="contact-icon bg-[#ef7f1a] text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <span><b>Telefon</b><small>071 688 78 51</small></span><span class="arrow">↗</span>
            </a>

            <a href="tel:+41774805454" class="contact-card group">
              <span class="contact-icon bg-[#292929] text-white">24</span>
              <span><b>24/7 Service</b><small>077 480 54 54</small></span><span class="arrow">↗</span>
            </a>

            <a href="mailto:Info@h-r-r.ch" class="contact-card group">
              <span class="contact-icon bg-white text-[#ef7f1a] border border-[#f1d4b6]">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <span><b>E-Mail</b><small>Info@h-r-r.ch</small></span><span class="arrow">↗</span>
            </a>
          </div>

          <div class="mt-7 rounded-2xl border border-[#e8e1da] bg-white/80 p-5 text-sm text-[#68635e] shadow-sm">
            <b class="text-[#292929]">H-R-R Facility GmbH</b><br />Hauptstrasse 137b · 8274 Tägerwilen<br /><span class="text-[#ef7f1a]">Region Kreuzlingen &amp; Winterthur</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .phone-mockup { width:min(310px,80vw); aspect-ratio:.51; border-radius:46px; padding:10px; background:linear-gradient(145deg,#4a4a4a,#151515 48%,#565656); box-shadow:0 32px 70px rgba(64,44,25,.26),0 0 65px rgba(239,127,26,.16); animation:phoneFloat 5s ease-in-out infinite; }
  .phone-notch { position:absolute; top:16px; left:50%; transform:translateX(-50%); width:96px; height:25px; border-radius:20px; background:#090909; z-index:3; }
  .phone-screen { height:100%; overflow:hidden; border-radius:37px; display:flex; flex-direction:column; background:linear-gradient(180deg,#fffaf5,#fff 56%,#f8f3ed); border:1px solid rgba(255,255,255,.7); }
  .message-bubble { border-radius:20px 20px 20px 6px; border:1px solid rgba(239,127,26,.22); background:linear-gradient(135deg,#fff4e9,#fff); color:#555; padding:18px; line-height:1.6; box-shadow:0 14px 28px rgba(76,52,28,.08); }
  .phone-mini { display:flex; min-width:0; flex-direction:column; align-items:center; justify-content:center; gap:4px; border-radius:12px; border:1px solid #ece3da; background:#fff; padding:9px 4px; color:#ef7f1a; font-weight:800; }
  .phone-mini small { font-size:9px; color:#777; font-weight:700; }
  .contact-card { min-height:92px; display:grid; grid-template-columns:54px 1fr auto; gap:14px; align-items:center; border:1px solid #e6dfd8; border-radius:18px; padding:16px; background:#fff; color:#292929; box-shadow:0 12px 34px rgba(70,49,31,.06); transition:.25s ease; }
  .contact-card:hover { transform:translateY(-3px); border-color:rgba(239,127,26,.55); box-shadow:0 18px 44px rgba(239,127,26,.12); }
  .contact-icon { width:52px; height:52px; border-radius:14px; display:grid; place-items:center; font-weight:800; }
  .contact-icon svg { width:24px; height:24px; }
  .contact-card b { display:block; font-size:1rem; }
  .contact-card small { display:block; margin-top:3px; color:#777; font-size:.82rem; }
  .arrow { color:#ef7f1a; font-size:1.4rem; transition:.25s ease; }
  .contact-card:hover .arrow { transform:translate(3px,-3px); }
  @keyframes phoneFloat { 0%,100%{transform:translateY(0) rotate(-1deg)} 50%{transform:translateY(-10px) rotate(1deg)} }
</style>
