---
import Layout from "../layouts/Main.astro";
import { Icon } from "astro-icon/components";
import { CONTACT } from "../consts";

const channels = [
  { icon: "lucide:phone", label: "Telefon", value: CONTACT.phone, href: CONTACT.phoneHref, ext: false },
  { icon: "lucide:message-circle", label: "WhatsApp", value: CONTACT.mobile, href: CONTACT.whatsappHref, ext: true },
  { icon: "lucide:mail", label: "E-Mail", value: CONTACT.email, href: CONTACT.emailHref, ext: false },
  { icon: "lucide:clock", label: "24/7 Notfall", value: CONTACT.mobile, href: CONTACT.mobileHref, ext: false },
];
---

<Layout title="Kontakt" description="Kontakt zu H-R-R Facility GmbH in Tägerwilen. Telefon, WhatsApp, E-Mail oder Offertanfrage für Privat und Geschäftlich.">
  <section class="bg-[var(--hrr-sand)]">
    <div class="site-shell py-12 md:py-16">
      <nav class="mb-6 text-sm text-[var(--hrr-muted)]" aria-label="Brotkrumen">
        <a href="/" class="hover:text-[var(--hrr-orange)]">Startseite</a>
        <span class="mx-2">/</span>
        <span class="text-[var(--hrr-ink)]">Kontakt</span>
      </nav>
      <h1 class="max-w-2xl">Kontaktieren Sie uns</h1>
      <p class="lead max-w-2xl">
        Rufen Sie uns an, schreiben Sie uns oder füllen Sie das Formular aus.
        Wir melden uns persönlich, in der Regel am gleichen oder nächsten Arbeitstag.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="site-shell grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <!-- Direkter Kontakt -->
      <div>
        <h2 class="!text-[26px]">Direkt erreichbar</h2>
        <ul class="mt-6 grid gap-3">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.ext ? "_blank" : undefined}
                rel={c.ext ? "noopener" : undefined}
                class="group flex items-center gap-4 rounded-[10px] border border-[var(--hrr-line)] p-4 transition-colors hover:border-[var(--hrr-orange)]"
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-[var(--hrr-orange-soft)] text-[var(--hrr-orange)]">
                  <Icon name={c.icon} size={20} />
                </span>
                <span>
                  <b class="block text-[var(--hrr-ink)]">{c.label}</b>
                  <span class="text-[var(--hrr-muted)]">{c.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-8 rounded-[10px] bg-[var(--hrr-sand)] p-6">
          <b class="text-[var(--hrr-ink)]">H-R-R Facility GmbH</b><br />
          {CONTACT.street}<br />
          {CONTACT.city}<br />
          <span class="text-[var(--hrr-muted)]">Einsatzgebiet: {CONTACT.region}</span>

          <b class="mt-5 block text-[var(--hrr-ink)]">Öffnungszeiten</b>
          <ul class="mt-1 grid gap-1">
            {CONTACT.hours.map((h) => (
              <li class="flex justify-between gap-4"><span>{h.days}</span><span class="text-[var(--hrr-muted)]">{h.time}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Formular -->
      <div class="rounded-[10px] border border-[var(--hrr-line)] p-6 md:p-9">
        <h2 class="!text-[26px]">Offerte anfragen</h2>
        <p class="text-[var(--hrr-muted)]">Je mehr wir über Ihr Objekt wissen, desto genauer wird die Offerte.</p>

        <form action="https://formsubmit.co/Info@h-r-r.ch" method="POST" class="mt-6 grid gap-4 sm:grid-cols-2">
          <input type="hidden" name="_subject" value="Neue Anfrage über h-r-r.ch" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

          <!-- Privat oder Geschäftlich, wird über den Link vorausgewählt (z. B. /contact?fuer=privat) -->
          <fieldset class="sm:col-span-2">
            <legend class="mb-2 text-sm font-semibold text-[var(--hrr-ink)]">Die Anfrage ist</legend>
            <div class="kind-switch">
              <label class="kind-switch__item">
                <input type="radio" name="Kundengruppe" value="Privat" checked />
                <span><Icon name="lucide:house" size={18} /> Privat</span>
              </label>
              <label class="kind-switch__item">
                <input type="radio" name="Kundengruppe" value="Geschäftlich" />
                <span><Icon name="lucide:building-2" size={18} /> Geschäftlich</span>
              </label>
            </div>
          </fieldset>

          <label class="grid gap-1.5 text-sm font-semibold text-[var(--hrr-ink)]">
            Name *
            <input type="text" name="Name" required class="field" autocomplete="name" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-[var(--hrr-ink)]">
            Telefon
            <input type="tel" name="Telefon" class="field" autocomplete="tel" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-[var(--hrr-ink)] sm:col-span-2">
            E-Mail *
            <input type="email" name="E-Mail" required class="field" autocomplete="email" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-[var(--hrr-ink)]">
            Dienstleistung
            <select name="Dienstleistung" id="field-service" class="field">
              <option>Reinigung</option>
              <option>Hauswartung</option>
              <option>Renovierungsarbeiten</option>
              <option>Gartenunterhalt</option>
              <option>Mehrere Leistungen</option>
            </select>
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-[var(--hrr-ink)]">
            Ort des Objekts
            <input type="text" name="Ort" class="field" />
          </label>
          <label class="grid gap-1.5 text-sm font-semibold text-[var(--hrr-ink)] sm:col-span-2">
            Ihre Nachricht *
            <textarea name="Nachricht" rows="5" required class="field" id="field-message" placeholder="z. B. Treppenhausreinigung, 3 Stockwerke, 1x pro Woche"></textarea>
          </label>
          <div class="sm:col-span-2 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-[var(--hrr-muted)]">* Pflichtfelder · kostenlos und unverbindlich</p>
            <button type="submit" class="btn-main cursor-pointer">Anfrage senden</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .kind-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .5rem;
    padding: .35rem;
    border-radius: 14px;
    background: var(--hrr-sand);
  }
  .kind-switch__item { position: relative; cursor: pointer; }
  .kind-switch__item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .kind-switch__item span {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: .75rem 1rem;
    border-radius: 10px;
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--hrr-muted);
    transition: background-color .3s ease, color .3s ease, box-shadow .3s ease;
  }
  .kind-switch__item:hover span { color: var(--hrr-ink); }
  .kind-switch__item input:checked + span {
    background: var(--hrr-orange);
    color: #fff;
    box-shadow: 0 8px 20px rgba(232, 118, 26, .3);
  }
  .kind-switch__item input:focus-visible + span {
    outline: 2px solid var(--hrr-orange);
    outline-offset: 2px;
  }
</style>

<script>
  // Vorauswahl aus dem Link übernehmen: ?fuer=privat oder ?fuer=geschaeftlich
  const params = new URLSearchParams(window.location.search);
  const kind = params.get("fuer");
  const message = document.getElementById("field-message") as HTMLTextAreaElement | null;

  if (kind === "geschaeftlich" || kind === "privat") {
    const value = kind === "geschaeftlich" ? "Geschäftlich" : "Privat";
    const radio = document.querySelector<HTMLInputElement>(`input[name="Kundengruppe"][value="${value}"]`);
    if (radio) radio.checked = true;
  }

  // Passendes Beispiel im Nachrichtenfeld
  const examples: Record<string, string> = {
    Privat: "z. B. Umzugsreinigung, 3,5 Zimmer, Abgabe am 30. des Monats",
    "Geschäftlich": "z. B. Treppenhausreinigung, 3 Stockwerke, 1x pro Woche",
  };
  const setExample = () => {
    const checked = document.querySelector<HTMLInputElement>('input[name="Kundengruppe"]:checked');
    if (message && checked) message.placeholder = examples[checked.value] ?? message.placeholder;
  };
  document.querySelectorAll<HTMLInputElement>('input[name="Kundengruppe"]').forEach((r) =>
    r.addEventListener("change", setExample)
  );
  setExample();
</script>
