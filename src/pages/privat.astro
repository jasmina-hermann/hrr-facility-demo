---
import Layout from "../layouts/Main.astro";
import AudiencePage from "../components/AudiencePage.astro";
import { IMAGES } from "../consts";
---

<Layout
  title="Privat: Reinigung, Hauswartung und Garten für Ihr Zuhause"
  description="Wohnungsreinigung, Umzugsreinigung mit Abgabe, Hauswartung und Gartenpflege für Privatkunden in Kreuzlingen, Winterthur und im Kanton Thurgau."
>
  <AudiencePage
    kind="privat"
    kicker="Für Privatkunden"
    title="Privat"
    tagline="Ihr Zuhause. Unsere Sorgfalt."
    icon="lucide:house"
    groupsTitle="Was wir bei Ihnen zu Hause übernehmen"
    groups={[
      {
        icon: "lucide:sparkles",
        title: "Regelmässige Reinigung",
        items: ["Wohnung und Haus", "Küche und Bad", "Böden und Teppiche", "Fenster und Rahmen", "Nach festem Plan oder auf Abruf"],
        href: "/reinigung#privat",
      },
      {
        icon: "lucide:package",
        title: "Umzug und Grundreinigung",
        items: ["Umzugsreinigung mit Abgabe", "Endreinigung", "Grundreinigung", "Bauendreinigung nach Umbau", "Fensterreinigung"],
        href: "/reinigung#spezial",
      },
      {
        icon: "lucide:key-round",
        title: "Haus und Hauswartung",
        items: ["Kontrolle während der Ferien", "Kleine Reparaturen", "Entsorgung und Ordnung", "Unterstützung im Notfall", "Kleine Renovierungen"],
        href: "/hauswartung#privat",
      },
      {
        icon: "lucide:trees",
        title: "Garten",
        items: ["Rasen mähen und pflegen", "Hecken- und Strauchschnitt", "Beete pflegen", "Laub entfernen", "Winterdienst"],
        href: "/garten",
      },
    ]}
    partnerTitle="Ihr Partner für ein gepflegtes Zuhause"
    partnerText={[
      "Seit über 20 Jahren reinigen und pflegen wir Wohnungen, Häuser und Gärten in Kreuzlingen, Winterthur und im Thurgau.",
      "Bei Ihnen arbeiten immer die gleichen Leute. Sie wissen, wer kommt, und wir kennen Ihr Zuhause. Wir besprechen mit Ihnen, was Sie brauchen, und machen eine klare Offerte. Regelmässig oder einmalig, ganz wie es für Sie passt.",
    ]}
    photo={{ src: "/img/Slideshow%209.jpg", fallback: IMAGES.team.src, alt: "Drei Mitarbeiterinnen der H-R-R Facility GmbH", pos: "center 30%" }}
  />
</Layout>
    image={IMAGES.garten}
    contactTitle="Offerte für Ihr Zuhause"
  />
</Layout>
