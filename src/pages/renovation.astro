---
import Layout from "../layouts/Main.astro";
import PageHero from "../components/PageHero.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import Steps from "../components/Steps.astro";
import Contacts from "../components/homepage/Contacts.astro";
---

<Layout
  title="Renovierungsarbeiten"
  description="Kleine Renovierungsarbeiten, Bau- und Sanierungsprojekte in Kreuzlingen, Winterthur und im Kanton Thurgau."
>
  <PageHero
    kicker="Dienstleistungen"
    title="Renovierungsarbeiten"
    text="Ausbessern, umbauen und sauber übergeben."
    icon="lucide:paint-roller"
  />

  <ServiceBlock
    id="leistungen"
    eyebrow="Unsere Leistungen"
    title="Vom kleinen Auftrag bis zum Sanierungsprojekt"
    text="Ob eine Wohnung nach dem Auszug wieder instand gestellt werden muss oder ein Raum umgebaut wird: Wir planen mit Ihnen und setzen um."
    points={[
      "Kleine Renovierungen",
      "Bau- und Sanierungsprojekte",
      "Innenausbau",
      "Umbauten",
      "Instandstellung bei Mieterwechsel",
      "Reinigung nach Abschluss",
    ]}
  />

  <section class="section section-sand">
    <div class="site-shell grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <span class="eyebrow">Alles aus einer Hand</span>
        <h2>Renovation und Reinigung ohne zweite Firma</h2>
        <p class="lead">
          Weil wir auch reinigen, ist nach den Arbeiten alles bezugsbereit. Sie haben einen Ansprechpartner
          vom ersten Gespräch bis zur sauberen Übergabe.
        </p>
      </div>
      <div class="photo photo--placeholder aspect-[4/3]">
        <span>(Bild folgt)</span>
      </div>
    </div>
  </section>

  <Steps />
  <Contacts title="Offerte für Ihre Renovation" />
</Layout>
