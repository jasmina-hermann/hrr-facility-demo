---
import Layout from "../layouts/Main.astro";
import AudiencePage from "../components/AudiencePage.astro";
import { IMAGES } from "../consts";
---

<Layout
  title="Geschäftlich: Reinigung und Hauswartung für Firmen und Verwaltungen"
  description="Treppenhausreinigung, Büroreinigung, Hauswartung, Endreinigung mit Abgabe und Umgebungspflege für Verwaltungen, Eigentümer und Firmen in Kreuzlingen, Winterthur und im Thurgau."
>
  <AudiencePage
    kind="geschaeftlich"
    kicker="Für Firmen und Verwaltungen"
    title="Geschäftlich"
    tagline="Ihr Betrieb. Unsere Verantwortung."
    icon="lucide:building-2"
    groupsTitle="Was wir für Ihren Betrieb übernehmen"
    groups={[
      {
        icon: "lucide:sparkles",
        title: "Regelmässige Reinigung",
        items: ["Treppenhäuser", "Büros und Praxen", "Läden und Gewerberäume", "Sanitär- und Küchenbereiche", "Eingangsbereiche und Lifte"],
        href: "/reinigung#geschaeftlich",
      },
      {
        icon: "lucide:key-round",
        title: "Hauswartung",
        items: ["Regelmässige Kontrollgänge", "Heizung und Haustechnik im Blick", "Kleine Reparaturen", "Waschküche und Gemeinschaftsräume", "Ansprechperson für Mieter"],
        href: "/hauswartung#geschaeftlich",
      },
      {
        icon: "lucide:calendar-check",
        title: "Einmalige Einsätze",
        items: ["Endreinigung mit Abgabe", "Bauendreinigung", "Grundreinigung", "Fensterreinigung", "Instandstellung bei Mieterwechsel"],
        href: "/reinigung#spezial",
      },
      {
        icon: "lucide:trees",
        title: "Umgebung und Renovation",
        items: ["Umgebungspflege nach festem Plan", "Winterdienst", "Entsorgung von Grüngut", "Kleine Renovierungen", "Innenausbau und Umbauten"],
        href: "/garten#liegenschaften",
      },
    ]}
    partnerTitle="Ihr Partner für Liegenschaften und Betriebe"
    partnerText={[
      "Wir arbeiten für Verwaltungen, Eigentümer, Firmen und Gewerbe in Kreuzlingen, Winterthur und im Thurgau.",
      "Ein Team übernimmt innen und aussen, Sie haben eine Ansprechperson für alles. Nach einer Besichtigung erhalten Sie eine klare Offerte, die zu Ihrem Objekt passt. Ohne versteckte Kosten.",
    ]}
    photo={IMAGES.reinigung}
  />
</Layout>
