---
import Layout from "../layouts/Main.astro";
---
<Layout title="Hauswartung | H-R-R Facility GmbH">
  <main class="bg-[#fbf8f4] py-8 md:py-12">
    <div class="site-shell">
      <a href="/" class="font-semibold text-[#ef7f1a]">← Zurück zur Übersicht</a>

      <div class="mt-6 overflow-hidden rounded-[30px] bg-white shadow-[0_24px_75px_rgba(61,44,28,.10)] lg:grid lg:grid-cols-[.9fr_1.1fr]">
        <div class="p-7 sm:p-10 lg:p-12">
          <p class="premium-kicker mb-3">Werterhalt &amp; Betreuung</p>
          <h1 class="!mb-4">Hauswartung</h1>
          <p class="max-w-xl text-xl leading-relaxed text-[#6b655f]">Für private und gewerbliche Liegenschaften, bei denen Sauberkeit, Funktionalität und ein gepflegter Eindruck dauerhaft stimmen sollen.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <span class="rounded-full bg-[#eaf3ef] px-4 py-2 text-sm font-bold text-[#0f6b57]">✓ Kontrolliert &amp; gepflegt</span>
            <span class="rounded-full bg-[#fff1e4] px-4 py-2 text-sm font-bold text-[#ef7f1a]">✓ Innen &amp; Aussen</span>
            <span class="rounded-full bg-[#eaf3ef] px-4 py-2 text-sm font-bold text-[#0f6b57]">✓ Persönliche Betreuung</span>
          </div>
        </div>
        <div class="min-h-[380px]">
          <img src="https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&fm=jpg&q=88&w=2600" alt="Luxuriöse moderne Villa" class="h-full w-full object-cover" />
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <a href="/hauswartung-privat" class="group premium-card relative overflow-hidden rounded-[28px] p-8 md:p-10 min-h-[320px] flex flex-col justify-between transition hover:-translate-y-1">
          <div class="absolute right-0 top-0 h-32 w-32 rounded-bl-[100px] bg-[#eaf3ef]"></div>
          <div class="relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#0f6b57] text-2xl text-white">⌂</div>
          <div class="relative z-10">
            <p class="text-[#0f6b57] font-bold mb-2 tracking-[0.12em]">HAUSWARTUNG</p>
            <h2 class="!text-4xl md:!text-5xl mb-4">Privat</h2>
            <p class="text-[#6b655f] leading-relaxed mb-5">Für Einfamilienhäuser, Villen und Mehrfamilienhäuser – zuverlässig betreut und abgestimmt auf Ihr Objekt.</p>
            <span class="font-semibold text-[#ef7f1a]">Leistungen ansehen →</span>
          </div>
        </a>

        <a href="/hauswartung-geschaeftlich" class="group premium-card relative overflow-hidden rounded-[28px] p-8 md:p-10 min-h-[320px] flex flex-col justify-between transition hover:-translate-y-1">
          <div class="absolute right-0 top-0 h-32 w-32 rounded-bl-[100px] bg-[#fff1e4]"></div>
          <div class="relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#ef7f1a] text-2xl text-white">▦</div>
          <div class="relative z-10">
            <p class="text-[#ef7f1a] font-bold mb-2 tracking-[0.12em]">HAUSWARTUNG</p>
            <h2 class="!text-4xl md:!text-5xl mb-4">Geschäftlich</h2>
            <p class="text-[#6b655f] leading-relaxed mb-5">Für Verwaltungen, Unternehmen und Gewerbeobjekte mit klaren Abläufen, festen Standards und verlässlicher Betreuung.</p>
            <span class="font-semibold text-[#0f6b57]">Leistungen ansehen →</span>
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>
