---
import Layout from "../layouts/Main.astro";
---
<Layout title="Hauswartung | H-R-R Facility GmbH">
  <main class="min-h-[75vh] bg-[#f7f7f5] py-16 md:py-24">
    <div class="container">
      <a href="/" class="text-[#f28c28] font-semibold">← Zurück zur Übersicht</a>
      <div class="max-w-3xl mt-8 mb-12">
        <p class="uppercase tracking-[0.22em] text-sm font-bold text-[#f28c28] mb-3">H-R-R Facility GmbH</p>
        <h1 class="text-5xl md:text-6xl font-bold mb-5">Hauswartung</h1>
        <p class="text-xl opacity-70">Welche Immobilie dürfen wir für Sie betreuen?</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
        <a href="/hauswartung-privat" class="group rounded-3xl bg-white border border-black/10 p-9 md:p-12 min-h-[320px] flex flex-col justify-between shadow-sm hover:shadow-xl transition">
          <span class="text-5xl">⌂</span>
          <div><p class="text-[#f28c28] font-bold mb-2">HAUSWARTUNG</p><h2 class="text-4xl font-bold mb-4">Privat</h2><p class="opacity-70 mb-5">Persönliche Betreuung für private Häuser, Mehrfamilienhäuser und Liegenschaften.</p><span class="font-semibold">Leistungen ansehen →</span></div>
        </a>
        <a href="/hauswartung-geschaeftlich" class="group rounded-3xl bg-white border border-black/10 p-9 md:p-12 min-h-[320px] flex flex-col justify-between shadow-sm hover:shadow-xl transition text-[#242424]">
          <span class="text-5xl">▦</span>
          <div><p class="text-[#f28c28] font-bold mb-2">HAUSWARTUNG</p><h2 class="text-4xl font-bold mb-4">Geschäftlich</h2><p class="opacity-70 mb-5">Facility- und Hauswartungsleistungen für Unternehmen, Verwaltungen und Gewerbeobjekte.</p><span class="font-semibold">Leistungen ansehen →</span></div>
        </a>
      </div>
    </div>
  </main>
</Layout>
