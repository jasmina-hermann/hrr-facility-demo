---
import Layout from "../layouts/Main.astro";
import PageHero from "../components/PageHero.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import Steps from "../components/Steps.astro";
import Contacts from "../components/homepage/Contacts.astro";
import { IMAGES } from "../consts";
---

<Layout
  title="Hauswartung"
  description="Hauswartung und Umgebungspflege für Liegenschaften, Unternehmen und Privathaushalte in Kreuzlingen, Winterthur und Umgebung."
>
  <PageHero
    eyebrow="Hauswartung"
    title="Hauswartung, auf die Sie sich verlassen können"
    text="Wir schauen regelmässig zum Rechten, beheben kleine Schäden und halten Innen- und Aussenbereiche in Ordnung – damit Ihre Liegenschaft ihren Wert behält."
    image={IMAGES.werkzeug}
  >
    <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-[15px] font-semibold text-[var(--hrr-ink)]">
      <a href="#geschaeftlich" class="underline decoration-[var(--hrr-orange)] decoration-2 underline-offset-4 hover:text-[var(--hrr-orange)]">Liegenschaften</a>
      <a href="#privat" class="underline decoration-[var(--hrr-orange)] decoration-2 underline-offset-4 hover:text-[var(--hrr-orange)]">Privat</a>
      <a href="#umgebung" class="underline decoration-[var(--hrr-orange)] decoration-2 underline-offset-4 hover:text-[var(--hrr-orange)]">Umgebungspflege</a>
    </div>
  </PageHero>

  <ServiceBlock
    id="geschaeftlich"
    eyebrow="Liegenschaften & Unternehmen"
    title="Hauswartung für Verwaltungen und Gewerbe"
    text="Ein fester Hauswart, klare Abläufe und kurze Wege: Wir sind Ansprechpartner für Verwaltung, Eigentümer und Mieter."
    points={[
      "Regelmässige Kontrollgänge",
      "Kleine Reparaturen",
      "Heizung und Haustechnik im Blick",
      "Leuchtmittel ersetzen",
      "Waschküche und Gemeinschaftsräume",
      "Ansprechpartner für Mieter",
    ]}
    image={IMAGES.hauswart}
  />

  <ServiceBlock
    id="privat"
    eyebrow="Privat"
    title="Hauswartung für Ihr Haus"
    text="Für Einfamilien- und Mehrfamilienhäuser. Wir übernehmen die Arbeiten, für die Ihnen die Zeit fehlt – regelmässig oder auf Abruf."
    points={[
      "Kontrolle bei Abwesenheit",
      "Kleine Reparaturen",
      "Entsorgung und Ordnung",
      "Unterstützung im Notfall",
    ]}
    image={IMAGES.liegenschaft}
    reverse
    sand
  />

  <ServiceBlock
    id="umgebung"
    eyebrow="Umgebungspflege"
    title="Gepflegte Aussenbereiche das ganze Jahr"
    text="Ein gepflegter Aussenbereich ist die Visitenkarte jeder Liegenschaft. Wir kümmern uns um Grünflächen, Wege und Plätze."
    points={[
      "Rasen mähen",
      "Hecken- und Strauchschnitt",
      "Plätze und Wege reinigen",
      "Laub entfernen",
      "Winterdienst",
    ]}
    image={IMAGES.rasen}
  />

  <Steps />
  <Contacts title="Offerte für Ihre Hauswartung" />
</Layout>
