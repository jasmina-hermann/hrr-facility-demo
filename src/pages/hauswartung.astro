---
import Layout from "../layouts/Main.astro";
import PageHero from "../components/PageHero.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import Steps from "../components/Steps.astro";
import Contacts from "../components/homepage/Contacts.astro";
---

<Layout
  title="Hauswartung"
  description="Hauswartung für Liegenschaften, Unternehmen und Privathaushalte in Kreuzlingen, Winterthur und Umgebung."
>
  <PageHero
    kicker="Dienstleistungen"
    title="Hauswartung"
    text="Kontrolle, Unterhalt und kleine Reparaturen."
    icon="lucide:key-round"
  />

  <ServiceBlock
    id="geschaeftlich"
    eyebrow="Liegenschaften & Unternehmen"
    title="Hauswartung für Verwaltungen und Gewerbe"
    text="Ein fester Hauswart, klare Abläufe und kurze Wege: Wir sind Ansprechpartner für Verwaltung, Eigentümer und Mieter."
    points={[
      "Regelmässige Kontrollgänge",
      "Kleine Reparaturen",
      "Heizung und Haustechnik im Blick",
      "Leuchtmittel ersetzen",
      "Waschküche und Gemeinschaftsräume",
      "Ansprechpartner für Mieter",
    ]}
  />

  <ServiceBlock
    id="privat"
    eyebrow="Privat"
    title="Hauswartung für Ihr Haus"
    text="Für Einfamilien- und Mehrfamilienhäuser. Wir übernehmen die Arbeiten, für die Ihnen die Zeit fehlt. Regelmässig oder auf Abruf."
    points={[
      "Kontrolle bei Abwesenheit",
      "Kleine Reparaturen",
      "Entsorgung und Ordnung",
      "Unterstützung im Notfall",
    ]}
    reverse
    sand
  />

  <Steps />
  <Contacts title="Offerte für Ihre Hauswartung" />
</Layout>
