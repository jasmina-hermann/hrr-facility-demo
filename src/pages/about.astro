---
import Layout from "../layouts/Main.astro";
import PageHero from "../components/PageHero.astro";
import Contacts from "../components/homepage/Contacts.astro";
import { IMAGES } from "../consts";

const values = [
  { title: "Verlässlichkeit", text: "Abmachungen gelten. Termine, Qualität und Kommunikation sind für Sie jederzeit nachvollziehbar." },
  { title: "Sorgfalt", text: "Saubere Arbeit bis ins Detail – ob im Treppenhaus, im Büro oder bei Ihnen zu Hause." },
  { title: "Nähe", text: "Persönliche Ansprechpartner aus der Region und kurze Wege, wenn etwas schnell gehen muss." },
];
---

<Layout title="Über uns" description="H-R-R Facility GmbH aus Tägerwilen – Reinigung und Hauswartung mit über 20 Jahren Erfahrung.">
  <PageHero
    eyebrow="Über uns"
    title="Ein Team aus der Region – für Ihre Liegenschaft"
    text="H-R-R Facility GmbH steht für zuverlässige Reinigung und Hauswartung. Wir betreuen Liegenschaften, Unternehmen und Privathaushalte in Kreuzlingen, Winterthur und Umgebung."
    image={IMAGES.hero}
  />

  <section class="section bg-white">
    <div class="site-shell grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Wer wir sind</span>
        <h2>Erfahrung, die man sieht</h2>
        <p class="lead">
          Mit über 20 Jahren Berufserfahrung wissen wir, worauf es ankommt: dass die Arbeit sauber gemacht wird,
          dass man uns erreicht und dass Abmachungen eingehalten werden.
        </p>
        <p class="mt-4 text-[var(--hrr-muted)]">
          Unser Sitz ist in Tägerwilen. Von hier aus sind wir mit eigenem Material und eingespielten Teams
          in der ganzen Region unterwegs – für regelmässige Einsätze ebenso wie für kurzfristige Aufträge.
        </p>
      </div>

      <ul class="grid gap-4 self-start sm:grid-cols-3 lg:grid-cols-1">
        <li class="rounded-[10px] bg-[var(--hrr-sand)] p-6"><span class="num">20+ Jahre</span><span class="text-[var(--hrr-muted)]">Erfahrung im Facility Service</span></li>
        <li class="rounded-[10px] bg-[var(--hrr-sand)] p-6"><span class="num">24/7</span><span class="text-[var(--hrr-muted)]">erreichbar für dringende Anliegen</span></li>
        <li class="rounded-[10px] bg-[var(--hrr-sand)] p-6"><span class="num">Tägerwilen</span><span class="text-[var(--hrr-muted)]">Einsätze in Kreuzlingen, Winterthur und Umgebung</span></li>
      </ul>
    </div>
  </section>

  <section class="section section-sand">
    <div class="site-shell">
      <span class="eyebrow">Wofür wir stehen</span>
      <h2>Unsere Werte</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {values.map((v) => (
          <div class="rounded-[10px] bg-white p-7">
            <h3>{v.title}</h3>
            <p class="text-[var(--hrr-muted)]">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Contacts />
</Layout>
